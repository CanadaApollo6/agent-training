 ONE_BUFFER = os.environ.get("TENSORFOLD_ONE_BUFFER") == "1"
 
 
+def _rows_schedule(text: str) -> list[tuple[int, int]]:
+    """"16:20000,12:50000,8": 16 rows below 20000 context tokens, 12 below 50000, then 8 (rows, below) steps."""
+    steps = []
+    for part in filter(None, text.replace(" ", "").split(",")):
+        rows, _, below = part.partition(":")
+        steps.append((int(rows), int(below) if below else 1 << 62))
+    return steps
+
+
+# long-context attention grows with the rows a round, so long contexts check fewer rows (README: rows a round)
+ROWS_BY_CONTEXT = _rows_schedule(os.environ.get("TENSORFOLD_ROWS_BY_CONTEXT", ""))
+
+
+def rows_for(context: int, rows: int) -> int:
+    for step, below in ROWS_BY_CONTEXT:
+        if context < below:
+            return min(step, rows)
+    return rows
+
