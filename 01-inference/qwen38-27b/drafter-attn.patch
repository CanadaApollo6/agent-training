+def matmul_rows_with(x: torch.Tensor, parts: list[QLinear], others: list[QLinear],
+                     xs: torch.Tensor | None = None) -> tuple[torch.Tensor, list[torch.Tensor]]:
+    """``(matmul_rows(x, parts, xs), [matmul(x, q, xs) for q in others])`` with the same bits, in one launch when the
+    weights fit one (each keeps its own K slices)."""
+
+    if xs is None:
+        xs = shared.group_sums(x, parts[0].gs)
+    if (len(parts) + len(others) <= 4 and all(q.fast and q.layout == "tiled" for q in others)
+            and shared.segmented(x, parts + others)):
+        sk = shared.split_k(sum(p.n for p in parts), parts[0].k, parts[0].gs)
+        outs = shared.matmul_many(x, parts + others, xs,
+                                  sks=[sk] * len(parts) + [shared.split_k(q.n, q.k, q.gs) for q in others])
+        return torch.cat(outs[:len(parts)], dim=1), outs[len(parts):]
+    return matmul_rows(x, parts, xs), [matmul(x, q, xs) for q in others]
