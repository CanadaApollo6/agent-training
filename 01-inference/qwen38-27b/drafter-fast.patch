+@triton.jit
+def _top16_merge(KEYS, HEAD_IDS, OUT_V, OUT_I, M: tl.constexpr, BLOCK: tl.constexpr):
+    """Program (row): the 16 largest of the row's chunk keys, as values and global word ids."""
+
+    row = tl.program_id(0)
