+@triton.jit
+def _top16_part(X, KEYS, N, CHUNKS, CHUNK: tl.constexpr, S: tl.constexpr):
+    """Program (row, chunk): the chunk's 16 largest keys. They sit in the 16 groups of S with the largest maxima,
+    so pick those groups first, then the 16 largest of their 16*S keys."""
+
+    row = tl.program_id(0)
+    chunk = tl.program_id(1)
+    cols = chunk * CHUNK + tl.arange(0, CHUNK // S)[:, None] * S + tl.arange(0, S)[None, :]
+    v = tl.load(X + row * N + cols, mask=cols < N, other=float("-inf")).to(tl.float32)
+    _, top = _top16_unkey(tl.topk(tl.max(_top16_key(v, cols), axis=1), 16))
+    cols = (top // S * S)[:, None] + tl.arange(0, S)[None, :]
+    v = tl.load(X + row * N + cols, mask=cols < N, other=float("-inf")).to(tl.float32)
+    keys = tl.topk(tl.reshape(_top16_key(v, cols), (16 * S,)), 16)
+    tl.store(KEYS + (row * CHUNKS + chunk) * 16 + tl.arange(0, 16), keys)
+
