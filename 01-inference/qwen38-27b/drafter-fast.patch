+@triton.jit
+def _top16_key(v, cols):
+    """fp32 -> int64 key, larger value larger key; equal values: the lower column larger."""
+
+    b = v.to(tl.int32, bitcast=True)
+    o = b ^ ((b >> 31) & 0x7fffffff)
+    return (o.to(tl.int64) << 32) | (2147483647 - cols).to(tl.int64)
+
+
+@triton.jit
+def _top16_unkey(k):
+    o = (k >> 32).to(tl.int32)
+    b = o ^ ((o >> 31) & 0x7fffffff)
+    return b.to(tl.float32, bitcast=True), 2147483647 - (k & 0xffffffff).to(tl.int32)
+
