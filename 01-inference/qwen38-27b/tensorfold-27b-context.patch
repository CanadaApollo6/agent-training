@@ -0,0 +1,295 @@
+"""One stream's verify trees (``TreeGraphs``, ``draft_decode(graphs=...)``) and DFlash2 blocks (``DraftGraphs``)
+replayed as CUDA graphs (Qwen3.8-27B).
+
+The eager verify launches ~600 kernels from Python a round; on a busy desktop the host falls behind the GPU. A graph
+per (width, GDN slot class, context bucket) replays the same kernels, so the bits are the eager forward's. Each round
+the host writes the tree into a pinned mirror (token ids, positions, the GDN schedule, the attention parents and the
+stream's committed length, the conv windows, the cache offsets) and copies it in before the replay; paths and depths
+are computed inside the graph. The GDN and conv states live in this object's own tensors (``load`` copies a request's
+state in), and ``commit`` writes them in place, so the graphs' addresses never move. Attention rows stay in the
+request's buffers, read through offsets refreshed each round.
+"""
+
+from __future__ import annotations
+
+import gc
+from dataclasses import dataclass
+from typing import Sequence
+
+import torch
+import torch.nn.functional as F
+
+from tensorfold.cuda.kernels import attention as tree_attention
+from tensorfold.cuda.kernels import gdn as deltanet
+
+from .forward import State, commit, tree_forward
+from .glue import embedding
+from .qmm_fast import matmul_rows
+
+BUCKET = 8192        # smallest context span a graph covers; larger contexts take the next power of two
+SLOT_CLASSES = (2, 4, 8, 16, 32)
+
+
+def slot_class(slots: int) -> int:
+    """The GDN kernel variant a schedule takes (``dispatch_tree``): 0 is the chain kernel."""
+
+    return 0 if slots == 0 else next(c for c in SLOT_CLASSES if slots <= c)
+
+
+@dataclass
+class TreeStaged:
+    """A tree window's device inputs, as ``tree_forward(staged=...)`` reads them, with their pinned host mirror."""
+
+    width: int
+    ids: torch.Tensor
+    pos: torch.Tensor
+    plan: deltanet.Plan
+    aplan: tree_attention.Plan
+    aoffs: dict
+    windows: torch.Tensor
+    host: torch.Tensor
+    dev: torch.Tensor
+    host64: torch.Tensor
+    dev64: torch.Tensor
+    at: dict                # name -> (start, length) in the int32 mirror
+    tree: bool = True       # tree_forward computes paths and depths from ``aplan.parents`` inside the graph
+
+
+class TreeGraphs:
+    def __init__(self, w) -> None:
+        self.w = w
+        self.st = State(w)                          # GDN/conv states at fixed addresses; kv from the request
+        c = w.config
+        self.group = c.heads // c.kv_heads
+        self.keep = next(s for s in self.st.conv if s is not None).shape[0]
+        self.softmax = [i for i, layer in enumerate(w.layers) if not layer.linear]
+        self.graphs: dict[tuple[int, int, int], tuple] = {}
+        self.pool = torch.cuda.graph_pool_handle()
+        self.replays = self.eager = 0
+        self.check = False                          # also run each window eagerly and require identical bits
+        self.mismatches = 0
+
+    # -- state ---------------------------------------------------------------------------------------------------
+    def load(self, st: State) -> State:
+        """Copy a request's committed GDN and conv states into the fixed ones, and point ``st`` at them (its own copies
+        go, so a request holds one set); attention rows stay in its buffers."""
+
+        for mine, theirs in ((self.st.rec, st.rec), (self.st.conv, st.conv)):
+            for i, dst in enumerate(mine):
+                if dst is not None:
+                    dst.copy_(theirs[i])
+                    theirs[i] = dst
+        self.st.kv = list(st.kv)
+        self.st.pos, self.st.limit, self.st.rope_delta = st.pos, st.limit, st.rope_delta
+        return self.st
+
+    def release(self, st: State) -> None:
+        """Hand the decoded state back to the request (its attention buffers, position) and drop this object's hold on
+        them, so a later prompt can reserve its window."""
+
+        if all(kv is None for kv in self.st.kv):         # released already
+            return
+        st.kv, st.pos, st.limit = list(self.st.kv), self.st.pos, self.st.limit
+        self.st.kv = [None] * len(self.st.kv)
+
+    def commit(self, record, path: Sequence[int]) -> None:
+        commit(self.st, record, path, in_place=True)
+
+    # -- staging -------------------------------------------------------------------------------------------------
+    def _rows(self) -> int:
+        return self.st.kv[self.softmax[0]][0].shape[0]
+
+    def _bucket(self, end: int) -> int:
+        return min(self._rows(), max(BUCKET, 1 << (end - 1).bit_length()))
+
+    def _stage(self, width: int, slots: int, context: int) -> TreeStaged:
+        device = self.w.norm.device
+        chain = list(range(-1, width - 1))
+        flat, n_items, chunks = tree_attention.padded_host(chain, context, self.group)
+        at, sizes = {}, [("ids", width), ("pos", width), ("entries", 3 * width), ("starts", 2), ("att", len(flat)),
+                         ("windows", width * (self.keep + 1))]
+        o = 0
+        for name, n in sizes:
+            at[name] = (o, n)
+            o += n
+        host = torch.zeros(o, dtype=torch.int32).pin_memory()
+        a0 = at["att"][0]
+        host[a0:a0 + len(flat)] = torch.tensor(flat, dtype=torch.int32)
+        s0 = at["starts"][0]
+        host[s0 + 1] = width
+        dev = host.to(device)
+        host64 = torch.zeros(2 * len(self.softmax), dtype=torch.int64).pin_memory()
+        dev64 = host64.to(device)
+
+        def view(name):
+            s, n = at[name]
+            return dev[s:s + n]
+
+        plan = deltanet.Plan(view("entries").view(width, 3), view("starts"), slots, width)
+        att = view("att")
+        rows = att[:width]
+        table = att[width:width + 4].view(1, 4)
+        items = att[width + 4:width + 4 + 3 * n_items].view(n_items, 3)
+        parents = att[width + 4 + 3 * n_items:width + 4 + 3 * n_items + width]
+        paths = torch.empty((width, tree_attention.MAX_NODES), dtype=torch.int32, device=device)
+        depths = torch.empty((width,), dtype=torch.int32, device=device)
+        aplan = tree_attention.Plan(rows, table, items, parents, paths, depths, chunks, width)
+        aoffs = {layer: dev64[2 * j:2 * j + 2].view(1, 2) for j, layer in enumerate(self.softmax)}
+        return TreeStaged(width, view("ids"), view("pos"), plan, aplan, aoffs,
+                          view("windows").view(width, self.keep + 1), host, dev, host64, dev64, at)
+
+    def _refresh(self, s: TreeStaged, tokens: Sequence[int], parents: Sequence[int], depths: Sequence[int],
+                 entries: Sequence[int]) -> None:
+        w, p, h, at = s.width, self.st.pos, s.host.numpy(), s.at
+
+        def put(name, values, offset=0):
+            start = at[name][0] + offset
+            h[start:start + len(values)] = values
+
+        put("ids", tokens)
+        put("pos", [p + self.st.rope_delta + d for d in depths])
+        put("entries", entries)
+        put("att", [p, -(-(p + w) // tree_attention.CHUNK)], offset=w + 2)     # the stream's committed keys, chunks
+        att_parents = at["att"][1] - w
+        put("att", parents, offset=att_parents)
+        keep, windows = self.keep, []
+        for row, parent in enumerate(parents):
+            tail = list(range(keep)) if parent < 0 else windows[parent][1:]
+            windows.append(tail + [keep + row])
+        put("windows", [x for win in windows for x in win])
+        s.host64.numpy()[:] = [o for i in self.softmax for o in tree_attention.offsets([self.st.kv[i]], s.dev.device)]
+        s.dev.copy_(s.host, non_blocking=True)
+        s.dev64.copy_(s.host64, non_blocking=True)
+
+    def _capture(self, fn):
+        torch.cuda.synchronize()
+        g = torch.cuda.CUDAGraph()
+        enabled = gc.isenabled()
+        gc.disable()                                    # collecting an old graph mid-capture invalidates it
+        try:
+            with torch.cuda.graph(g, pool=self.pool):
+                out = fn()
+        finally:
+            if enabled:
+                gc.enable()
+        return g, out
+
+    # -- verify --------------------------------------------------------------------------------------------------
+    @torch.no_grad()
+    def verify(self, tokens: Sequence[int], parents: Sequence[int], *, capture_taps: bool = True):
+        """``tree_forward(w, tokens, parents, st, capture_taps=...)`` on the fixed state, replayed; None past the
+        buffers (the caller runs it eagerly)."""
+
+        width, st = len(tokens), self.st
+        if st.pos + width > self._rows():
+            self.eager += 1
+            return None
+        depths = [0] * width
+        for row in range(1, width):
+            depths[row] = depths[parents[row]] + 1
+        entries, _, slots, _ = deltanet.plan_host([parents])
+        key = (width, slot_class(slots), self._bucket(st.pos + width))
+        entry = self.graphs.get(key)
+        if entry is None:
+            staged = self._stage(width, key[1], key[2])
+            self._refresh(staged, tokens, parents, depths, entries)
+            run = lambda: tree_forward(self.w, staged.ids, list(parents), st, capture_taps=capture_taps, staged=staged)
+            run()                                       # compiles and tunes each kernel outside the capture
+            self._refresh(staged, tokens, parents, depths, entries)
+            g, out = self._capture(run)
+            entry = self.graphs[key] = (g, staged, out)
+        g, staged, out = entry
+        self._refresh(staged, tokens, parents, depths, entries)
+        g.replay()
+        self.replays += 1
+        if self.check:
+            ref = tree_forward(self.w, torch.tensor(list(tokens), dtype=torch.int32, device=self.w.norm.device),
+                               list(parents), st, capture_taps=capture_taps)
+            self.mismatches += not all(torch.equal(a, b) for a, b in zip((out[0], *out[2:]), (ref[0], *ref[2:])))
+        return out
+
+
+@dataclass
+class BlockStaged:
+    length: int
+    host: torch.Tensor      # int64: block tokens, first position, each layer's (keys, values) pointers, context rows
+    dev: torch.Tensor
+    steps: torch.Tensor     # arange(length) on the device
+
+
+class DraftGraphs:
+    """DFlash2's ``launch_block`` (one stream, the fused 4-bit path) replayed from a graph per block length.
+
+    The context keys and values stay where ``add_taps`` leaves them: the block attention reads them through a pointer
+    table refreshed each round, so the replay is the eager launch's kernels on the same inputs. Install with
+    ``draft.launch_block = DraftGraphs(draft).launch_block``.
+    """
+
+    def __init__(self, draft) -> None:
+        if not draft.fast or draft.world != 1 or draft.sub_rows is None:
+            raise ValueError("drafter graphs take one GPU's fused path with a tiled target head")
+        self.d = draft
+        self.eager_launch = draft.launch_block
+        self.graphs: dict[int, tuple] = {}
+        self.pool = torch.cuda.graph_pool_handle()
+        self.check = False
+        self.mismatches = self.replays = 0
+
+    def _stage(self, length: int) -> BlockStaged:
+        host = torch.zeros(length + 2 + 2 * self.d.layers, dtype=torch.int64).pin_memory()
+        device = self.d.device
+        return BlockStaged(length, host, host.to(device), torch.arange(length, device=device))
+
+    def _refresh(self, s: BlockStaged, pending: int) -> None:
+        d, h, n = self.d, s.host.numpy(), s.length
+        h[:n] = [pending] + [d.mask_id] * (n - 1)
+        h[n] = d.context_end
+        h[n + 1:n + 1 + 2 * d.layers] = [p for kc, vc in zip(d.kc, d.vc) for p in (kc.data_ptr(), vc.data_ptr())]
+        h[n + 1 + 2 * d.layers] = d.kc[0].shape[1]
+        s.dev.copy_(s.host, non_blocking=True)
+
+    def _body(self, s: BlockStaged):
+        """``launch_blocks``' fused path for one stream, every host-built input read from ``s.dev``."""
+
+        d, n, dev = self.d, s.length, s.dev
+        x = embedding(dev[:n].to(torch.int32), d.target_embed)
+        phase = (dev[n] + s.steps).to(torch.float32)[:, None] * d.inv_freq[None, :]
+        cos, sin = phase.cos().contiguous(), phase.sin().contiguous()
+        lens = dev[n + 1 + 2 * d.layers:n + 2 + 2 * d.layers].to(torch.int32)
+        for layer in range(d.layers):
+            x = d._layer_fast(layer, x, cos, sin, [], n, (dev[n + 1 + 2 * layer:n + 3 + 2 * layer], lens))
+        h = F.rms_norm(x[1:], (d.hidden,), d.weights["norm.weight"], d.eps)
+        projected = d._lin(h, "candidate_selector.hidden_projection.weight").float()
+        values, local_ids = torch.topk(matmul_rows(h, d.sub_rows).float(), k=16, dim=-1, sorted=False)
+        return d.head_ids[local_ids], torch.cat((values, projected), dim=1)
+
+    @torch.no_grad()
+    def launch_block(self, pending: int, max_nodes: int, block: int | None = None):
+        d = self.d
+        if d.context_len <= 0 or max_nodes < 1:
+            return self.eager_launch(pending, max_nodes, block)
+        n = min(block or d.block, max_nodes + 1)
+        entry = self.graphs.get(n)
+        if entry is None:
+            s = self._stage(n)
+            self._refresh(s, pending)
+            self._body(s)                               # compiles each kernel outside the capture
+            torch.cuda.synchronize()
+            g = torch.cuda.CUDAGraph()
+            enabled = gc.isenabled()
+            gc.disable()
+            try:
+                with torch.cuda.graph(g, pool=self.pool):
+                    out = self._body(s)
+            finally:
+                if enabled:
+                    gc.enable()
+            entry = self.graphs[n] = (g, s, out)
+        g, s, (ids, floats) = entry
+        self._refresh(s, pending)
+        g.replay()
+        self.replays += 1
+        if self.check:
+            ref = self.eager_launch(pending, max_nodes, block)[0]
+            self.mismatches += not (torch.equal(ids, ref[0]) and torch.equal(floats, ref[1]))
+        return ([ids, floats, None], 0, n - 1, int(pending))
