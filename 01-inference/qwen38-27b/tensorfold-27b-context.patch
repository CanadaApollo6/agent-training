@@ -0,0 +1,80 @@
+"""An 8-bit attention cache: each (row, key head) packs D int8 codes, then D / 32 fp16 scales (absmax / 127).
+
+``TENSORFOLD_KV_BITS=8`` turns it on (default 16: bf16 rows). A packed cache keeps the bf16 cache's (rows, kv heads,
+width) shape with int8 elements, so growing, slicing and copying it are unchanged; only the writes (``store``) and the
+attention kernels' reads (``load_rows``) know the layout. 8.5 bits a value: 272 bytes a 256-wide head row, not 512.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra import libdevice
+
+BITS = int(os.environ.get("TENSORFOLD_KV_BITS", "16"))
+if BITS not in (8, 16):
+    raise ValueError("TENSORFOLD_KV_BITS takes 8 or 16")
+GROUP = 32
+
+
+def width(d: int) -> int:
+    """A cache row's last-axis length in its own elements: bf16 values, or int8 codes plus fp16 scales as bytes."""
+
+    return d if BITS == 16 else d + 2 * (d // GROUP)
+
+
+def dtype() -> torch.dtype:
+    return torch.bfloat16 if BITS == 16 else torch.int8
+
+
+@triton.jit
+def load_rows(C, row, d, mask, D: tl.constexpr, QBITS: tl.constexpr):
+    """bf16 (len(row), D) values of cache rows starting at element ``row`` (a row-head's first element)."""
+
+    if QBITS == 16:
+        x = tl.load(C + row[:, None] + d[None, :], mask=mask[:, None], other=0.0).to(tl.bfloat16)
+    else:
+        codes = tl.load(C + row[:, None] + d[None, :], mask=mask[:, None], other=0)
+        scales = tl.load((C + row[:, None] + D).to(tl.pointer_type(tl.float16)) + d[None, :] // 32,
+                         mask=mask[:, None], other=0.0)
+        x = (codes.to(tl.float32) * scales.to(tl.float32)).to(tl.bfloat16)
+    return x
+
+
+@triton.jit
+def _quant(X, OUT, D: tl.constexpr, R: tl.constexpr):
+    rh = tl.program_id(0)
+    g = tl.arange(0, D // 32)
+    j = tl.arange(0, 32)
+    x = tl.load(X + rh * D + g[:, None] * 32 + j[None, :]).to(tl.float32)
+    scale = tl.maximum(tl.max(tl.abs(x), axis=1) / 127.0, 1e-7).to(tl.float16)
+    codes = libdevice.rint(x / scale.to(tl.float32)[:, None])
+    codes = tl.minimum(tl.maximum(codes, -127.0), 127.0).to(tl.int8)
+    tl.store(OUT + rh * R + g[:, None] * 32 + j[None, :], codes)
+    tl.store((OUT + rh * R + D).to(tl.pointer_type(tl.float16)) + g, scale)
+
+
+def store(dst: torch.Tensor, x: torch.Tensor) -> None:
+    """Write bf16 rows ``x`` (n, kv heads, D) into cache rows ``dst`` (n, kv heads, ``width(D)``)."""
+
+    if BITS == 16:
+        dst.copy_(x)
+        return
+    n, hk, d = x.shape
+    if dst.shape != (n, hk, width(d)) or dst.dtype != torch.int8 or not dst.is_contiguous():
+        raise ValueError("an 8-bit cache store takes contiguous int8 rows of the packed width")
+    if n:
+        _quant[(n * hk,)](x.contiguous(), dst, D=d, R=width(d), num_warps=2)
+
+
+def unpack(rows: torch.Tensor, d: int) -> torch.Tensor:
+    """bf16 (n, kv heads, D) values of cache rows (tests and reference paths)."""
+
+    if BITS == 16:
+        return rows
+    codes = rows[..., :d].float()
+    scales = rows[..., d:].contiguous().view(torch.float16).float()
+    return (codes.view(*codes.shape[:-1], d // GROUP, GROUP) * scales[..., None]).view(*codes.shape).to(torch.bfloat16)
