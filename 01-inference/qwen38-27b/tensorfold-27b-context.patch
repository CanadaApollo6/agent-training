@@ -0,0 +1,193 @@
+"""A quantized attention cache, packed per (row, key head) into int8 elements.
+
+``TENSORFOLD_KV_BITS``: 16 (default, bf16 rows), 8 or 4. A packed cache keeps the bf16 cache's (rows, kv heads,
+width) shape with int8 elements, so growing, slicing and copying it are unchanged; only the writes (``store``) and the
+attention kernels' reads (``load_rows``) know the layout.
+- 8: D int8 codes, then D / 32 fp16 scales (absmax / 127). 8.5 bits a value: 272 bytes a 256-wide head row, not 512.
+- 4: each 32 values rotated by H32 (ExLlamaV3's scheme, ``qwen4_exp/cuda/kvquant.py``), then D / 2 bytes of 4-bit
+  codes on the midpoint grid (low nibble first), then D / 32 fp16 scales (the rotated absmax). 4.5 bits a value:
+  144 bytes. ``load_rows`` returns rotated values: the attention wrappers ``rotate`` the queries (and any keys and values
+  not from the cache) once, which keeps q.k, and rotate the output back once (H32 is its own inverse).
+"""
+
+from __future__ import annotations
+
+import functools
+import os
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra import libdevice
+
+BITS = int(os.environ.get("TENSORFOLD_KV_BITS", "16"))
+if BITS not in (4, 8, 16):
+    raise ValueError("TENSORFOLD_KV_BITS takes 4, 8 or 16")
+GROUP = 32
+
+
+def width(d: int) -> int:
+    """A cache row's last-axis length in its own elements: bf16 values, or int8 codes plus fp16 scales as bytes."""
+
+    return d if BITS == 16 else d * BITS // 8 + 2 * (d // GROUP)
+
+
+def dtype() -> torch.dtype:
+    return torch.bfloat16 if BITS == 16 else torch.int8
+
+
+@triton.jit
+def _h32_stage(x, M: tl.constexpr, HI: tl.constexpr, LO: tl.constexpr):
+    t = tl.trans(tl.reshape(x, (M, HI, 2, LO)), 0, 1, 3, 2)
+    a, b = tl.split(t)
+    return tl.reshape(tl.trans(tl.join(a + b, a - b), 0, 1, 3, 2), (M, 32))
+
+
+@triton.jit
+def h32(x, M: tl.constexpr):
+    """H32 over the last axis of an (M, 32) fp32 block, scaled so H32 H32 = I (qwen4_exp's transform)."""
+
+    x = _h32_stage(x, M, 16, 1)
+    x = _h32_stage(x, M, 8, 2)
+    x = _h32_stage(x, M, 4, 4)
+    x = _h32_stage(x, M, 2, 8)
+    x = _h32_stage(x, M, 1, 16)
+    return x * 0.17677669529663688110
+
+
+@triton.jit
+def load_rows(C, row, d, mask, D: tl.constexpr, QBITS: tl.constexpr):
+    """bf16 (len(row), D) values of cache rows starting at element ``row`` (a row-head's first element)."""
+
+    if QBITS == 16:
+        x = tl.load(C + row[:, None] + d[None, :], mask=mask[:, None], other=0.0).to(tl.bfloat16)
+    elif QBITS == 4:
+        N: tl.constexpr = row.shape[0]
+        half = tl.arange(0, D // 2)
+        raw = tl.load(C + row[:, None] + half[None, :], mask=mask[:, None], other=0).to(tl.int32)
+        q = tl.reshape(tl.join((raw & 15).to(tl.float32), ((raw >> 4) & 15).to(tl.float32)), (N, D))
+        g = tl.arange(0, D // 32)
+        scales = tl.load((C + row[:, None] + D // 2).to(tl.pointer_type(tl.float16)) + g[None, :],
+                         mask=mask[:, None], other=0.0).to(tl.float32)
+        x = tl.reshape(q, (N, D // 32, 32)) - 7.5
+        x = x * (scales * 0.125)[:, :, None]
+        x = tl.reshape(x, (N, D)).to(tl.bfloat16)
+    else:
+        codes = tl.load(C + row[:, None] + d[None, :], mask=mask[:, None], other=0)
+        scales = tl.load((C + row[:, None] + D).to(tl.pointer_type(tl.float16)) + d[None, :] // 32,
+                         mask=mask[:, None], other=0.0)
+        x = (codes.to(tl.float32) * scales.to(tl.float32)).to(tl.bfloat16)
+    return x
+
+
+@triton.jit
+def _quant(X, OUT, D: tl.constexpr, R: tl.constexpr):
+    rh = tl.program_id(0)
+    g = tl.arange(0, D // 32)
+    j = tl.arange(0, 32)
+    x = tl.load(X + rh * D + g[:, None] * 32 + j[None, :]).to(tl.float32)
+    scale = tl.maximum(tl.max(tl.abs(x), axis=1) / 127.0, 1e-7).to(tl.float16)
+    codes = libdevice.rint(x / scale.to(tl.float32)[:, None])
+    codes = tl.minimum(tl.maximum(codes, -127.0), 127.0).to(tl.int8)
+    tl.store(OUT + rh * R + g[:, None] * 32 + j[None, :], codes)
+    tl.store((OUT + rh * R + D).to(tl.pointer_type(tl.float16)) + g, scale)
+
+
+@triton.jit
+def _quant4(X, OUT, D: tl.constexpr, R: tl.constexpr):
+    rh = tl.program_id(0)
+    G: tl.constexpr = D // 32
+    g = tl.arange(0, G)
+    j = tl.arange(0, 32)
+    x = h32(tl.load(X + rh * D + g[:, None] * 32 + j[None, :]).to(tl.float32), G)
+    s = tl.max(tl.abs(x), axis=1) + 1e-10
+    q = tl.floor(x * tl.math.div_rn(1.0, s)[:, None] * 8.0) + 8.0
+    q = tl.minimum(tl.maximum(q, 0.0), 15.0).to(tl.int32)
+    lo, hi = tl.split(tl.reshape(q, (D // 2, 2)))
+    tl.store(OUT + rh * R + tl.arange(0, D // 2), (lo | (hi << 4)).to(tl.uint8).to(tl.int8, bitcast=True))
+    tl.store((OUT + rh * R + D // 2).to(tl.pointer_type(tl.float16)) + g, s.to(tl.float16))
+
+
+def store(dst: torch.Tensor, x: torch.Tensor) -> None:
+    """Write bf16 rows ``x`` (n, kv heads, D) into cache rows ``dst`` (n, kv heads, ``width(D)``)."""
+
+    if BITS == 16:
+        dst.copy_(x)
+        return
+    n, hk, d = x.shape
+    if dst.shape != (n, hk, width(d)) or dst.dtype != torch.int8 or not dst.is_contiguous():
+        raise ValueError("a quantized cache store takes contiguous int8 rows of the packed width")
+    if n:
+        (_quant if BITS == 8 else _quant4)[(n * hk,)](x.contiguous(), dst, D=d, R=width(d), num_warps=2)
+
+
+def roundtrip(x: torch.Tensor) -> torch.Tensor:
+    """Uncommitted keys or values (n, kv heads, D) as the attention kernels will read them once committed: stored
+    and loaded back (rotated for a 4-bit cache), with ``load_rows``'s arithmetic. A verify window's rows then see their
+    path's keys exactly as serial decoding sees them from the cache, so drafted replies equal serial ones."""
+
+    if BITS == 16:
+        return x
+    n, hk, d = x.shape
+    rows = torch.empty((n, hk, width(d)), dtype=torch.int8, device=x.device)
+    store(rows, x)
+    if BITS == 4:
+        raw = rows[..., :d // 2].view(torch.uint8).int()
+        q = torch.stack([raw & 15, raw >> 4], -1).flatten(-2).float()
+        scales = rows[..., d // 2:].contiguous().view(torch.float16).float()
+        y = (q.unflatten(-1, (d // GROUP, GROUP)) - 7.5) * (scales * 0.125)[..., None]
+        return y.flatten(-2).to(torch.bfloat16).contiguous()
+    codes = rows[..., :d].float()
+    scales = rows[..., d:].contiguous().view(torch.float16).float()
+    return (codes.unflatten(-1, (d // GROUP, GROUP)) * scales[..., None]).flatten(-2).to(torch.bfloat16).contiguous()
+
+
+@triton.jit
+def _rotate(X, Y, groups, M: tl.constexpr):
+    g = tl.program_id(0) * M + tl.arange(0, M)
+    ok = g < groups
+    j = tl.arange(0, 32)
+    x = tl.load(X + g[:, None] * 32 + j[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+    tl.store(Y + g[:, None] * 32 + j[None, :], h32(x, M).to(Y.dtype.element_ty), mask=ok[:, None])
+
+
+def rotate(x: torch.Tensor) -> torch.Tensor:
+    """H32 over each 32 values of the last axis for a 4-bit cache (its own inverse); unchanged otherwise.
+
+    One Triton butterfly a group, so a row's bits never depend on how many rows there are. (A torch fp32 matmul here
+    picked cuBLAS kernels by row count: verify windows of 3-9 rows rounded their queries differently from 1, 2, 12
+    or 16, and drafted replies at those widths left serial decoding's.)"""
+
+    if BITS != 4:
+        return x
+    x = x.contiguous()
+    y = torch.empty_like(x)
+    groups = x.numel() // GROUP
+    if groups:
+        _rotate[(triton.cdiv(groups, 64),)](x, y, groups, M=64, num_warps=4)
+    return y
+
+
+def unpack(rows: torch.Tensor, d: int) -> torch.Tensor:
+    """bf16 (n, kv heads, D) values of cache rows (tests and reference paths)."""
+
+    if BITS == 16:
+        return rows
+    if BITS == 4:
+        raw = rows[..., :d // 2].view(torch.uint8).int()
+        q = torch.stack([raw & 15, raw >> 4], -1).flatten(-2).float()
+        scales = rows[..., d // 2:].contiguous().view(torch.float16).float()
+        x = (q.unflatten(-1, (d // GROUP, GROUP)) - 7.5) * (scales * 0.125)[..., None]
+        return (x @ _hadamard32(x.device)).flatten(-2).to(torch.bfloat16)
+    codes = rows[..., :d].float()
+    scales = rows[..., d:].contiguous().view(torch.float16).float()
+    return (codes.view(*codes.shape[:-1], d // GROUP, GROUP) * scales[..., None]).view(*codes.shape).to(torch.bfloat16)
+
+
+@functools.lru_cache(maxsize=None)
+def _hadamard32(device) -> torch.Tensor:
+    """H32 in natural order, built on the device (no host copy, so safe inside a CUDA graph capture)."""
+
+    i = torch.arange(32, device=device)
+    bits = ((i[:, None] & i[None, :])[None] >> torch.arange(5, device=device)[:, None, None]) & 1
+    return (1 - 2 * (bits.sum(0) % 2)).float() / 32 ** 0.5
