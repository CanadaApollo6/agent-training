+# TENSORFOLD_KV_STEP=N: grow attention caches to the next multiple of N rows instead of doubling. Doubling holds up
+# to twice the rows in use, and the allocator keeps the outgrown buffers: on a 24 GB card that halves the context.
+KV_STEP = int(os.environ.get("TENSORFOLD_KV_STEP", "0"))
+
