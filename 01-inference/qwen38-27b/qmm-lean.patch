+def launch_split(qs) -> list[int]:
+    """K slices for weights that share a launch: none once the launch's column tiles fill the GPU (slices add a sum and
+    the narrow weights hide inside the wide one's blocks), else each weight's ``split_k``. A function of the call's
+    shapes only (never of the row count); a lone weight gets its ``split_k``."""
+    if sum(-(-q.n // 64) for q in qs) >= FILL:
+        return [1] * len(qs)
+    return [split_k(q.n, q.k, q.gs) for q in qs]
