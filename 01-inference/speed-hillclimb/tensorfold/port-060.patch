+        count = values.shape[0]
+        higher = (values[None, :] > values[:, None]) | ((values[None, :] == values[:, None])
+                                                        & (tokens[None, :] < tokens[:, None]))
+        rank = higher.sum(dim=1)                                    # (-value, id) order: np.lexsort((ids, -values))
+        order = torch.empty_like(rank).scatter_(0, rank, torch.arange(count, device=rank.device))
+        k = max(1, min(int(top_k) if top_k else count, count))
+        order = order[:k]
+        scaled = values.index_select(0, order).double() / self.floats[0]
+        u = keyed_uniform(self.ints[:1], self.ints[1:2] + step, tokens.index_select(0, order))
+        score = scaled - torch.log(-torch.log(u))
+        probs = torch.exp(scaled - scaled[:1])
+        probs = probs / probs.sum()
+        keep = (torch.cumsum(probs, 0) < self.floats[1]).sum() + 1
+        cut = (torch.arange(k, device=score.device) >= keep) | (scaled < scaled[:1] + self.floats[2])
+        score = score.masked_fill(cut, float("-inf"))
+        return order.index_select(0, score.argmax().view(1))
+
