+                __syncthreads();
+                if (t == 0) {
+                    const uint32_t at = s_above++;
+                    const unsigned long long packed = __ldcg(&g->min_packed);
+                    cand_v[at] = value_of_key(threshold);
+                    cand_col[at] = static_cast<int64_t>(packed & 0xFFFFFFull);
+                    cand_id[at] = static_cast<int64_t>(packed >> 24);
+                }
+                __syncthreads();
+                last = cand_id[s_above - 1];
+                __syncthreads();
+            }
+        }
+    }
+    __syncthreads();
+
+    // 3. (-value, id) order, then each candidate's scaled logit and keyed Gumbel score
+    const double temperature = floats[0], top_p = floats[1], min_log = floats[2];
+    const uint64_t seed = static_cast<uint64_t>(ints[0]);
+    const uint64_t position = static_cast<uint64_t>(ints[1] + step);
+    if (t < k) {
+        int rank = 0;
+        for (int j = 0; j < k; ++j)
+            rank += cand_v[j] > cand_v[t] || (cand_v[j] == cand_v[t] && cand_id[j] < cand_id[t]);
+        const double s = static_cast<double>(cand_v[t]) / temperature;
+        scaled[rank] = s;
+        score[rank] = s - log(-log(keyed_uniform(seed, position, static_cast<uint64_t>(cand_id[t]))));
+        sorted_col[rank] = cand_col[t];
+    }
+    // the scratch back to zero for the next draw (every block's reads of it came before the last barrier)
+    for (int j = t; j < 4 * 256; j += THREADS) (&g->hist[0][0])[j] = 0;
+    if (t == 0) { g->count = 0; g->ties = 0; }
+    __syncthreads();
+
+    // 4. choose_rows' cuts and argmax, in its operation order; the float64 exps and divisions (slow on GeForce
+    //    parts) side by side, only the sums in order
+    if (t < k) probs[t] = exp(scaled[t] - scaled[0]);
+    __syncthreads();
+    if (t == 0) s_total = numpy_sum(probs, k);
+    __syncthreads();
+    if (t < k) probs[t] = probs[t] / s_total;
+    __syncthreads();
+    if (t == 0) {
+        double running = 0.0;
+        int keep = 1;
+        for (int i = 0; i < k; ++i) {
+            running += probs[i];
+            keep += running < top_p;
+        }
+        int best = 0;
+        double best_score = -INFINITY;
+        for (int i = 0; i < k; ++i) {
+            const bool cut = i >= keep || scaled[i] < scaled[0] + min_log;
+            const double s = cut ? -INFINITY : score[i];
+            if (s > best_score) { best_score = s; best = i; }
+        }
+        out[0] = sorted_col[best];
+    }
+}
+
+template <typename T>
+void launch(const T* row, const int64_t* ids, int64_t width, const int64_t* ints, const double* floats, int step,
+            int top_k, Scratch* scratch, int64_t* out, cudaStream_t stream) {
+    int device = 0, sms = 0, per_sm = 0;
+    C10_CUDA_CHECK(cudaGetDevice(&device));
+    C10_CUDA_CHECK(cudaDeviceGetAttribute(&sms, cudaDevAttrMultiProcessorCount, device));
+    C10_CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per_sm, keyed_draw_kernel<T>, THREADS, 0));
+    const int64_t wanted = (width + THREADS - 1) / THREADS;
+    const int blocks = static_cast<int>(std::max<int64_t>(1, std::min<int64_t>(wanted, int64_t(sms) * per_sm)));
+    void* args[] = {(void*)&row, (void*)&ids, (void*)&width, (void*)&ints, (void*)&floats, (void*)&step,
+                    (void*)&top_k, (void*)&scratch, (void*)&out};
+    C10_CUDA_CHECK(cudaLaunchCooperativeKernel((const void*)keyed_draw_kernel<T>, dim3(blocks), dim3(THREADS), args, 0,
+                                               stream));
+}
+
+}  // namespace
+
+int64_t keyed_scratch_bytes() { return sizeof(Scratch); }
+
+void keyed_draw_cuda(const at::Tensor& row, const c10::optional<at::Tensor>& ids, const at::Tensor& ints,
+                     const at::Tensor& floats, int64_t step, int64_t top_k, at::Tensor& scratch, at::Tensor& out) {
+    const at::cuda::CUDAGuard guard(row.device());
+    const cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+    const int64_t* id_ptr = ids.has_value() ? ids->data_ptr<int64_t>() : nullptr;
+    auto* g = reinterpret_cast<Scratch*>(scratch.data_ptr());
+    if (row.scalar_type() == at::kBFloat16)
+        launch(reinterpret_cast<const __nv_bfloat16*>(row.data_ptr<at::BFloat16>()), id_ptr, row.numel(),
+               ints.data_ptr<int64_t>(), floats.data_ptr<double>(), static_cast<int>(step), static_cast<int>(top_k), g,
+               out.data_ptr<int64_t>(), stream);
+    else
+        launch(row.data_ptr<float>(), id_ptr, row.numel(), ints.data_ptr<int64_t>(), floats.data_ptr<double>(),
+               static_cast<int>(step), static_cast<int>(top_k), g, out.data_ptr<int64_t>(), stream);
+}
