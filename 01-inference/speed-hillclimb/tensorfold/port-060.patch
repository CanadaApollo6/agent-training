+class DeviceSampling:
+    """A request's keyed rule staged on the device, so a captured graph can draw by it: the seed and the first
+    position (int64), then 1 / max(temperature, 1e-6) as ``choose`` divides by it, top_p (2 when off: keeps every
+    candidate) and ln(min_p) (-inf when off). ``set`` copies a new request's values in without a wait."""
+
+    def __init__(self, device) -> None:
+        self.host_i = torch.zeros(2, dtype=torch.int64).pin_memory()
+        self.host_f = torch.zeros(3, dtype=torch.float64).pin_memory()
+        self.ints = self.host_i.to(device)
+        self.floats = self.host_f.to(device)
+
+    def set(self, s: Sampling, first: int) -> None:
+        seed = int(s.seed) & 0xFFFFFFFFFFFFFFFF
+        self.host_i[0], self.host_i[1] = _signed(seed), int(first)
+        self.host_f[0] = max(float(s.temperature), 1e-6)
+        self.host_f[1] = float(s.top_p) if 0.0 < s.top_p < 1.0 else 2.0
+        self.host_f[2] = s.min_log
+        self.ints.copy_(self.host_i, non_blocking=True)
+        self.floats.copy_(self.host_f, non_blocking=True)
+
+    def pick(self, values: torch.Tensor, tokens: torch.Tensor, step: int, top_k: int) -> torch.Tensor:
+        """``choose`` on the device for one row of candidates (``values`` float32 [k], ``tokens`` int64 [k]) at the
+        position ``first + step``: the index into the candidates of the drawn token, [1], no wait.
+
+        The order, cut and keyed Gumbel draw are ``choose``'s. The float64 exp, sum and log are the device's, which
+        can differ from numpy's in the last bit, so a near-tie can draw another token. That only changes a draft:
+        the verify still samples on the host."""
