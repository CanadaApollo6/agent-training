index 0000000..6a2a66d
--- /dev/null
+++ b/src/tensorfold/cuda/kernels/keyed.py
@@ -0,0 +1,34 @@
+"""The keyed draw of one row in one cooperative launch (``keyed.cu``): ``exact_sampling.choose`` over the whole row,
+spread over the SMs, no host wait."""
+
+from __future__ import annotations
+
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+MAX_K = 256     # the largest top_k a draw takes
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tensorfold_keyed_v6", sources=[str(here / "keyed.cpp"), str(here / "keyed.cu")],
+                extra_cuda_cflags=["-O3", "--fmad=false"], verbose=False)
+
+
+def scratch(device) -> torch.Tensor:
+    """The zeroed device scratch a ``draw`` needs (each draw leaves it zero); one per stream of draws."""
+
+    return torch.zeros(_ext().scratch_bytes(), dtype=torch.uint8, device=device)
+
+
+def draw(row: torch.Tensor, ids: torch.Tensor | None, ints: torch.Tensor, floats: torch.Tensor, step: int,
+         top_k: int, work: torch.Tensor, out: torch.Tensor) -> torch.Tensor:
+    """The column of ``row`` drawn at position ``ints[1] + step`` (``DeviceSampling``'s staged rule), into ``out``."""
+
+    _ext().draw(row.contiguous(), ids, ints, floats, int(step), int(top_k), work, out)
+    return out
