+def _mix_words(x: torch.Tensor) -> torch.Tensor:
+    x = x ^ _shr(x, 30)
+    x = x * _MIX1
+    x = x ^ _shr(x, 27)
+    x = x * _MIX2
+    return x ^ _shr(x, 31)
+
+
+def keyed_uniform(seed: torch.Tensor, position: torch.Tensor, ids: torch.Tensor) -> torch.Tensor:
+    """``exact_sampling.uniform`` on the device, same bits: ``seed`` and ``position`` int64 [1], ``ids`` int64."""
+
+    x = _mix_words(seed + _GOLDEN)
+    x = _mix_words(x ^ (position * _POS))
+    x = _mix_words(x ^ ids)
+    return _shr(x, 11).double() * 2.0 ** -53 + 2.0 ** -54
+
