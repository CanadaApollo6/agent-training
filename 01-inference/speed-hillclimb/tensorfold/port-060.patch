new file mode 100644
index 0000000..0e413a3
--- /dev/null
+++ b/src/tensorfold/cuda/kernels/keyed.cu
@@ -0,0 +1,369 @@
+// The keyed draw (``exact_sampling.choose``) for one row of logits in one cooperative launch, with no host wait (a
+// graph captures it):
+//   1. the top_k by (value, then token id) through a radix select over order-preserving keys. The first pass (the
+//      top byte) runs over the whole grid; the keys in the chosen bin and above (a few hundred for a row of logits)
+//      then go to one block, which finishes the select in shared memory. Should more than POOL keys share the top
+//      bytes (a flat row, a wide tie), the grid runs every pass instead.
+//   2. the splitmix64-keyed Gumbel argmax with the top_p and min_p cuts on that block, in choose_rows' order.
+#include <torch/extension.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <cooperative_groups.h>
+#include <cuda_bf16.h>
+#include <algorithm>
+#include <cstdint>
+
+namespace cg = cooperative_groups;
+
+namespace {
+
+constexpr int THREADS = 256;         // one thread a bin
+constexpr int MAX_K = 256;
+constexpr uint32_t POOL = 2048;      // keys finished on one block
+constexpr uint32_t TIE_CAP = 2048;   // equals at the threshold ranked by id at once; past it, a pass over the row each
+
+// The draws' scratch in global memory: zero before the first draw, and each draw leaves it zero again.
+struct Scratch {
+    uint32_t hist[4][256];
+    uint32_t count, ties;
+    unsigned long long min_packed;
+    uint32_t pool_key[POOL];
+    int32_t pool_col[POOL];
+    float cand_v[MAX_K];
+    int64_t cand_col[MAX_K], cand_id[MAX_K];
+    long long tie_id[TIE_CAP];
+    int32_t tie_col[TIE_CAP];
+};
+
+// The select so far: the key bits fixed (prefix under mask), how many more keys of that prefix the top k needs,
+// and the chosen bin's count (count) and the count of its bin and above (total).
+struct Select {
+    uint32_t prefix, mask, need, count, total;
+    int bin;
+};
+
+__device__ __forceinline__ float value_of(const float* row, int64_t i) { return row[i]; }
+__device__ __forceinline__ float value_of(const __nv_bfloat16* row, int64_t i) { return __bfloat162float(row[i]); }
+
+// larger float -> larger key (NaNs aside; -0.0 as 0.0, as numpy's sort has them)
+__device__ __forceinline__ uint32_t key_of(float v) {
+    const uint32_t u = __float_as_uint(v + 0.0f);
+    return (u & 0x80000000u) ? ~u : (u | 0x80000000u);
+}
+
+__device__ __forceinline__ float value_of_key(uint32_t key) {
+    return __uint_as_float((key & 0x80000000u) ? (key & 0x7FFFFFFFu) : ~key);
+}
+
+__device__ __forceinline__ uint64_t mix(uint64_t x) {
+    x ^= x >> 30;
+    x *= 0xBF58476D1CE4E5B9ull;
+    x ^= x >> 27;
+    x *= 0x94D049BB133111EBull;
+    return x ^ (x >> 31);
+}
+
+// exact_sampling.uniform: (seed, position, token id) -> (0, 1)
+__device__ __forceinline__ double keyed_uniform(uint64_t seed, uint64_t position, uint64_t id) {
+    uint64_t x = mix(seed + 0x9E3779B97F4A7C15ull);
+    x = mix(x ^ (position * 0xD1B54A32D192ED03ull));
+    x = mix(x ^ id);
+    return static_cast<double>(x >> 11) * 0x1.0p-53 + 0x1.0p-54;
+}
+
+// numpy's float64 sum of a short contiguous array (pairwise_sum, n <= 128): eight strided partial sums, folded
+// pairwise, then the tail; under 8 elements, in order
+__device__ double numpy_sum(const double* a, int n) {
+    if (n < 8) {
+        double s = 0.0;   // numpy starts from -0.0 here; the same for any nonzero sum
+        for (int i = 0; i < n; ++i) s += a[i];
+        return s;
+    }
+    double r[8];
+    for (int j = 0; j < 8; ++j) r[j] = a[j];
+    int i = 8;
+    for (; i < n - (n % 8); i += 8)
+        for (int j = 0; j < 8; ++j) r[j] += a[i + j];
+    double s = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]));
+    for (; i < n; ++i) s += a[i];
+    return s;
+}
+
+// One digit of the select, block-wide, thread t holding bin t's count: the highest bin whose keys and those of
+// the bins above reach need. ``suffix``: 257 sums and a total for each warp.
+__device__ void select_bin(uint32_t own, int shift, uint32_t* suffix, Select& sel) {
+    const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    uint32_t v = own;                   // the warp's suffix sums by shuffles, then the warps above added
+    for (int o = 1; o < 32; o <<= 1) {
+        const uint32_t other = __shfl_down_sync(0xffffffffu, v, o);
+        if (lane + o < 32) v += other;
+    }
+    if (lane == 0) suffix[256 + 1 + warp] = v;
+    if (t == 0) { suffix[256] = 0; sel.bin = 0; }
+    __syncthreads();
+    for (int w = warp + 1; w < THREADS / 32; ++w) v += suffix[256 + 1 + w];
+    suffix[t] = v;
+    __syncthreads();
+    const uint32_t need = sel.need;
+    if (suffix[t] >= need && suffix[t + 1] < need) sel.bin = t;
+    __syncthreads();
+    if (t == sel.bin) {
+        sel.need = need - suffix[t + 1];
+        sel.prefix |= static_cast<uint32_t>(t) << shift;
+        sel.mask |= 255u << shift;
+        sel.count = own;
+        sel.total = suffix[t];
+    }
+    __syncthreads();
+}
+
+// The needed equals of the threshold by lowest token id, from the tie list, after the above candidates.
+__device__ void take_ties(const Scratch* g, uint32_t ties, uint32_t needed, uint32_t above, float v, float* cand_v,
+                          int64_t* cand_col, int64_t* cand_id) {
+    for (uint32_t j = threadIdx.x; j < ties; j += THREADS) {
+        const long long id = __ldcg(&g->tie_id[j]);
+        uint32_t rank = 0;
+        for (uint32_t m = 0; m < ties; ++m) rank += __ldcg(&g->tie_id[m]) < id;
+        if (rank < needed) {
+            cand_v[above + rank] = v;
+            cand_col[above + rank] = __ldcg(&g->tie_col[j]);
+            cand_id[above + rank] = id;
+        }
+    }
+}
+
+template <typename T>
+__global__ void __launch_bounds__(THREADS) keyed_draw_kernel(
+        const T* __restrict__ row, const int64_t* __restrict__ ids, int64_t width,
+        const int64_t* __restrict__ ints, const double* __restrict__ floats, int step, int top_k,
+        Scratch* __restrict__ g, int64_t* __restrict__ out) {
+    cg::grid_group grid = cg::this_grid();
+    __shared__ uint32_t hist[256], suffix[257 + THREADS / 32];
+    __shared__ Select sel;
+    __shared__ uint32_t pool_key[POOL];
+    __shared__ int32_t pool_col[POOL];
+    __shared__ uint32_t s_above, s_ties;
+    __shared__ float cand_v[MAX_K];
+    __shared__ int64_t cand_col[MAX_K], cand_id[MAX_K], sorted_col[MAX_K];
+    __shared__ double scaled[MAX_K], score[MAX_K], probs[MAX_K];
+    __shared__ double s_total;
+    const int t = threadIdx.x;
+    const int64_t stride = static_cast<int64_t>(gridDim.x) * THREADS;
+    const int64_t first = static_cast<int64_t>(blockIdx.x) * THREADS + t;
+    const int k = static_cast<int>(width < top_k ? width : static_cast<int64_t>(top_k));
+
+    // 1. the top byte over the grid: each block's histogram adds into the global one; after the barrier every
+    //    block reads it and picks the same bin
+    if (t == 0) { sel.prefix = 0; sel.mask = 0; sel.need = k; }
+    hist[t] = 0;
+    __syncthreads();
+    for (int64_t i = first; i < width; i += stride) atomicAdd(&hist[key_of(value_of(row, i)) >> 24], 1u);
+    __syncthreads();
+    if (hist[t]) atomicAdd(&g->hist[0][t], hist[t]);
+    grid.sync();
+    select_bin(__ldcg(&g->hist[0][t]), 24, suffix, sel);
+
+    uint32_t threshold, ties_needed, ties, above;
+    if (sel.total <= POOL) {
+        // 2a. the keys in the bin and above to block 0, which finishes the select and takes the candidates
+        const uint32_t low = sel.prefix;
+        for (int64_t i = first; i < width; i += stride) {
+            const uint32_t key = key_of(value_of(row, i));
+            if (key >= low) {
+                const uint32_t at = atomicAdd(&g->count, 1u);
+                g->pool_key[at] = key;
+                g->pool_col[at] = static_cast<int32_t>(i);
+            }
+        }
+        grid.sync();
+        if (blockIdx.x != 0) return;
+        const uint32_t n = sel.total;
+        for (uint32_t j = t; j < n; j += THREADS) {
+            pool_key[j] = __ldcg(&g->pool_key[j]);
+            pool_col[j] = __ldcg(&g->pool_col[j]);
+        }
+        for (int shift = 16; shift >= 0; shift -= 8) {
+            hist[t] = 0;
+            __syncthreads();
+            const uint32_t prefix = sel.prefix, mask = sel.mask;
+            for (uint32_t j = t; j < n; j += THREADS)
+                if ((pool_key[j] & mask) == prefix) atomicAdd(&hist[(pool_key[j] >> shift) & 255u], 1u);
+            __syncthreads();
+            select_bin(hist[t], shift, suffix, sel);
+        }
+        threshold = sel.prefix, ties_needed = sel.need, ties = sel.count;
+        const bool some_ties = ties_needed != ties;
+        if (t == 0) { s_above = 0; s_ties = 0; }
+        __syncthreads();
+        for (uint32_t j = t; j < n; j += THREADS) {
+            const uint32_t key = pool_key[j];
+            const int32_t col = pool_col[j];
+            if (key > threshold || (key == threshold && !some_ties)) {
+                const uint32_t at = atomicAdd(&s_above, 1u);
+                cand_v[at] = value_of_key(key);
+                cand_col[at] = col;
+                cand_id[at] = ids ? ids[col] : col;
+            } else if (key == threshold) {
+                const uint32_t at = atomicAdd(&s_ties, 1u);
+                g->tie_col[at] = col;
+                g->tie_id[at] = ids ? ids[col] : col;
+            }
+        }
+        __syncthreads();
+        above = s_above;
+        if (some_ties) take_ties(g, ties, ties_needed, above, value_of_key(threshold), cand_v, cand_col, cand_id);
+    } else {
+        // 2b. a flat top: the other three bytes over the grid too, then the candidates over the grid
+        for (int shift = 16, pass = 1; shift >= 0; shift -= 8, ++pass) {
+            hist[t] = 0;
+            __syncthreads();
+            const uint32_t prefix = sel.prefix, mask = sel.mask;
+            for (int64_t i = first; i < width; i += stride) {
+                const uint32_t key = key_of(value_of(row, i));
+                if ((key & mask) == prefix) atomicAdd(&hist[(key >> shift) & 255u], 1u);
+            }
+            __syncthreads();
+            if (hist[t]) atomicAdd(&g->hist[pass][t], hist[t]);
+            grid.sync();
+            select_bin(__ldcg(&g->hist[pass][t]), shift, suffix, sel);
+        }
+        threshold = sel.prefix, ties_needed = sel.need, ties = sel.count;
+        const bool some_ties = ties_needed != ties;
+        for (int64_t i = first; i < width; i += stride) {
+            const uint32_t key = key_of(value_of(row, i));
+            if (key > threshold || (key == threshold && !some_ties)) {
+                const uint32_t at = atomicAdd(&g->count, 1u);
+                g->cand_v[at] = value_of_key(key);
+                g->cand_col[at] = i;
+                g->cand_id[at] = ids ? ids[i] : i;
+            } else if (key == threshold && ties <= TIE_CAP) {
+                const uint32_t at = atomicAdd(&g->ties, 1u);
+                g->tie_col[at] = static_cast<int32_t>(i);
+                g->tie_id[at] = ids ? ids[i] : i;
+            }
+        }
