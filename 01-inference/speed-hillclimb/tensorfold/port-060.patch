+                unsigned long long best = ~0ull;
+                for (int64_t i = t; i < width; i += THREADS) {
+                    if (key_of(value_of(row, i)) != threshold) continue;
+                    const int64_t id = ids ? ids[i] : i;
+                    if (id > last) {    // the low 24 bits hold the column for the lookup back (rows of up to 16M)
