diff --git a/tests/cuda/test_experts_lowbit.py b/tests/cuda/test_experts_lowbit.py
new file mode 100644
index 0000000..d647e15
--- /dev/null
+++ b/tests/cuda/test_experts_lowbit.py
@@ -0,0 +1,105 @@
+"""2- and 3-bit experts (bit planes): the same levels give the 4-bit kernels' exact bits, decode and prefill, with the
+shared expert kept at 4 bits beside them."""
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tensorfold.cuda import experts  # noqa: E402
+
+DEV = "cuda"
+GS = 64
+
+
+def mlx_words(q: torch.Tensor, bits: int) -> torch.Tensor:
+    """Levels [..., K] -> MLX words [..., K * bits / 32]: an LSB-first bitstream (as mx.quantize packs)."""
+
+    bitsarr = ((q.to(torch.int64)[..., None] >> torch.arange(bits, device=q.device)) & 1).reshape(*q.shape[:-1], -1, 32)
+    v = (bitsarr << torch.arange(32, device=q.device)).sum(-1)
+    return torch.where(v >= 2 ** 31, v - 2 ** 32, v).to(torch.int32)
+
+
+def tensor(e: int, n: int, k: int, bits: int, seed: int):
+    g = torch.Generator(device=DEV).manual_seed(seed)
+    q = torch.randint(0, 2 ** bits, (e, n, k), generator=g, device=DEV)
+    scales = (torch.rand((e, n, k // GS), generator=g, device=DEV) * 0.02 + 0.001).to(torch.bfloat16)
+    biases = (torch.randn((e, n, k // GS), generator=g, device=DEV) * 0.02).to(torch.bfloat16)
+    return q, scales, biases
+
+
+def as_bits(t, bits: int):
+    q, s, b = t
+    return mlx_words(q, bits), s, b
+
+
+def test_levels_round_trip():
+    for bits in (2, 3, 4):
+        q, _, _ = tensor(3, 32, 256, bits, bits)
+        assert torch.equal(experts.levels(mlx_words(q, bits), bits).long(), q)
+
+
+def run(ex, x, picks, *, prefill=False, y_dtype=torch.float32):
+    rows, slots = picks.shape
+    plan = experts.Plan(rows, slots, ex.count, DEV, prefill=prefill)
+    experts.route(picks.contiguous(), plan)
+    act = torch.empty((rows * slots, ex.width), dtype=torch.bfloat16, device=DEV)
+    y = torch.empty((rows * slots, ex.dims), dtype=y_dtype, device=DEV)
+    experts.gate_up(x, ex, plan, act, rows)
+    experts.down(act, ex, plan, y, rows)
+    return act, y
+
+
+def pair(bits_up, bits_down, e=18, d=512, ni=128):
+    """The same levels twice: narrow experts with a 4-bit shared expert beside them, and all at 4 bits."""
+
+    up = [tensor(e, ni, d, bits_up, 10 + i) for i in range(2)]
+    down = tensor(e, d, ni, bits_down, 20)
+    s_up = [tensor(1, ni, d, 4, 30 + i) for i in range(2)]
+    s_down = tensor(1, d, ni, 4, 40)
+    narrow = experts.make([as_bits(t, bits_up) for t in up], as_bits(down, bits_down), GS, limit=10.0,
+                          shared=([as_bits(t, 4) for t in s_up], as_bits(s_down, 4)))
+    cat = lambda t, st: tuple(torch.cat([a, b]) for a, b in zip(t, st))  # noqa: E731
+    full = experts.make([as_bits(cat(t, st), 4) for t, st in zip(up, s_up)], as_bits(cat(down, s_down), 4), GS,
+                        limit=10.0)
+    return narrow, full
+
+
+def picks_for(rows, e, k=6, seed=5):
+    g = torch.Generator().manual_seed(seed)
+    return torch.stack([torch.cat([torch.randperm(e, generator=g)[:k], torch.tensor([e])])
+                        for _ in range(rows)]).to(torch.int32).to(DEV)
+
+
+WIDTHS = [(2, 3), (3, 3), (2, 2), (3, 4), (4, 2)]
+
+
+@pytest.mark.parametrize("prefill,y_dtype", [(False, torch.float32), (True, torch.float32), (True, torch.bfloat16)])
+@pytest.mark.parametrize("bits_up,bits_down", WIDTHS)
+def test_narrow_experts_match_the_4bit_kernels(bits_up, bits_down, prefill, y_dtype):
+    narrow, full = pair(bits_up, bits_down)
+    assert (narrow.bits_up, narrow.bits_down) == (bits_up, bits_down) and narrow.count == full.count == 19
+    rows = 150 if prefill else 37
+    x = (torch.randn((rows, 512), device=DEV) * 0.5).to(torch.bfloat16)
+    picks = picks_for(rows, 18)
+    a_n, y_n = run(narrow, x, picks, prefill=prefill, y_dtype=y_dtype)
+    a_f, y_f = run(full, x, picks, prefill=prefill, y_dtype=y_dtype)
+    assert torch.equal(a_n, a_f) and torch.equal(y_n, y_f)
+
+
+@pytest.mark.parametrize("bits_up,bits_down", [(2, 3), (3, 3)])
+def test_narrow_pairs_do_not_depend_on_the_window(bits_up, bits_down):
+    narrow, _ = pair(bits_up, bits_down)
+    rows = 24
+    x = (torch.randn((rows, 512), device=DEV) * 0.5).to(torch.bfloat16)
+    picks = picks_for(rows, 18, seed=9)
+    act, y = run(narrow, x, picks)
+    alone = [run(narrow, x[r:r + 1], picks[r:r + 1]) for r in range(rows)]
+    assert torch.equal(act, torch.cat([a[0] for a in alone])) and torch.equal(y, torch.cat([a[1] for a in alone]))
+
+
+def test_narrow_is_smaller():
+    narrow, full = pair(2, 3)
+    # a block: 2 * bits words a lane (4-bit: 8), then 32 words of scales and biases
+    assert (narrow.up.shape[-1], narrow.down.shape[-1], full.up.shape[-1]) == (160, 224, 288)
diff --git a/tests/cuda/test_experts_split.py b/tests/cuda/test_experts_split.py
new file mode 100644
index 0000000..c28ce0d
--- /dev/null
+++ b/tests/cuda/test_experts_split.py
@@ -0,0 +1,52 @@
+"""The decode kernel (weights as the mma's A, S warps sharing a unit's groups, then folding them in order) gives the
+one-warp reference kernel's exact bits: every width, 1 to 16 rows (items past 8 pairs take two passes), groups that
+don't divide by S, the 4-bit shared expert beside narrow ones."""
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tensorfold.cuda import experts  # noqa: E402
+
+from test_experts_lowbit import GS, as_bits, picks_for, run, tensor  # noqa: E402
+
+WIDTHS = [(4, 4), (3, 3), (2, 3), (2, 2), (4, 2)]
+
+
+def layer(bits_up, bits_down, e=18, d=320, ni=192):
+    """d = 5 groups (gate/up), ni = 3 groups (down): rounds of 2, 4 and 8 warps end part full."""
+
+    up = [as_bits(tensor(e, ni, d, bits_up, 50 + i), bits_up) for i in range(2)]
+    down = as_bits(tensor(e, d, ni, bits_down, 60), bits_down)
+    shared = ([as_bits(tensor(1, ni, d, 4, 70 + i), 4) for i in range(2)], as_bits(tensor(1, d, ni, 4, 80), 4))
+    return experts.make(up, down, GS, limit=10.0, shared=shared)
+
+
+@pytest.mark.parametrize("bits_up,bits_down", WIDTHS)
+def test_split_equals_one_warp(bits_up, bits_down, monkeypatch):
+    ex = layer(bits_up, bits_down)
+    g = torch.Generator().manual_seed(bits_up * 10 + bits_down)
+    for rows in (1, 2, 3, 6, 16):
+        x = (torch.randn((rows, ex.dims), generator=g) * 0.5).to(torch.bfloat16).to("cuda")
+        picks = picks_for(rows, 18, seed=rows)
+        monkeypatch.setattr(experts, "SPLIT", -1)
+        want = run(ex, x, picks)
+        for split in (0, 1, 2, 4, 8):
+            monkeypatch.setattr(experts, "SPLIT", split)
+            got = run(ex, x, picks)
+            assert torch.equal(got[0], want[0]) and torch.equal(got[1], want[1]), (rows, split)
+
+
+def test_relu2_split_equals_one_warp(monkeypatch):
+    up = [as_bits(tensor(12, 128, 256, 4, 90), 4)]
+    ex = experts.make(up, as_bits(tensor(12, 256, 128, 4, 91), 4), GS)
+    x = (torch.randn((4, 256), generator=torch.Generator().manual_seed(3)) * 0.5).to(torch.bfloat16).to("cuda")
+    picks = picks_for(4, 12, k=5)[:, :5].contiguous()
+    monkeypatch.setattr(experts, "SPLIT", -1)
+    want = run(ex, x, picks)
+    for split in (0, 1, 2, 4):
+        monkeypatch.setattr(experts, "SPLIT", split)
+        got = run(ex, x, picks)
+        assert torch.equal(got[0], want[0]) and torch.equal(got[1], want[1]), split
diff --git a/tests/cuda/test_keyed_draw.py b/tests/cuda/test_keyed_draw.py
new file mode 100644
index 0000000..5a3302e
--- /dev/null
+++ b/tests/cuda/test_keyed_draw.py
@@ -0,0 +1,68 @@
+"""The keyed draw kernel (``kernels/keyed.cu``) picks what ``choose_rows`` picks over the row's exact top_k by
+(value, token id): bf16 ties, wide ties at the top and past the tie list, token ids mapped or not, each rule's cut."""
+
+import numpy as np
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tensorfold.cuda.kernels import keyed  # noqa: E402
+from tensorfold.cuda.sampling import DeviceSampling  # noqa: E402
+from tensorfold.engine.exact_sampling import Sampling, choose_rows  # noqa: E402
+
+
+def _host(row: torch.Tensor, ids, s: Sampling, position: int) -> int:
+    vals = row.float().cpu().numpy()
+    tok = ids.cpu().numpy() if ids is not None else np.arange(row.shape[0])
+    order = np.lexsort((tok, -vals))[:max(1, min(s.top_k, row.shape[0]))]
+    return int(choose_rows(vals[order][None], tok[order][None].astype(np.int64), [position], s)[0])
+
+
+@pytest.mark.parametrize("width", [79600, 256, 7])
+def test_draw_equals_choose_rows(width):
+    rng = np.random.default_rng(width)
+    dev = "cuda"
+    ds, out, work = DeviceSampling(dev), torch.zeros(1, dtype=torch.int64, device=dev), keyed.scratch(dev)
+    mapped = torch.tensor(np.sort(rng.choice(248000, width, replace=False)), device=dev)
+    rules = [dict(), dict(top_p=1.0), dict(min_p=0.05), dict(temperature=0.6), dict(top_k=40, top_p=0.8),
+             dict(top_k=1), dict(top_k=256)]
+    for cfg in rules:
+        for t in range(30):
+            s = Sampling(seed=int(rng.integers(0, 2**63)), **cfg)
+            row = torch.randn(width, device=dev) * 3
+            if t % 2 == 0:
+                row = row.bfloat16()                                    # bf16: ties are common
+            if t % 5 == 0:
+                row[torch.randperm(width, device=dev)[:40]] = row.max()  # a tie across the top
+            if t % 11 == 0:
+                row[torch.randperm(width, device=dev)[:5000]] = row.max()  # past the pool and the tie list
+            ids = mapped if t % 3 else None
+            pos, step = int(rng.integers(0, 100000)), int(rng.integers(0, 3))
+            ds.set(s, pos)
+            keyed.draw(row, ids, ds.ints, ds.floats, step, s.top_k, work, out)
+            tok = int(out.item()) if ids is None else int(ids[int(out.item())].item())
+            assert tok == _host(row, ids, s, pos + step), (cfg, t)
+
+
+def test_draw_replays_in_a_graph():
+    dev = "cuda"
+    row = torch.randn(79600, device=dev)
+    ds, work = DeviceSampling(dev), keyed.scratch(dev)
+    s = Sampling(seed=7)
+    ds.set(s, 100)
+    stream = torch.cuda.Stream()
+    with torch.cuda.stream(stream):
+        out = keyed.draw(row, None, ds.ints, ds.floats, 0, s.top_k, work,
+                         torch.empty(1, dtype=torch.int64, device=dev))
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        keyed.draw(row, None, ds.ints, ds.floats, 0, s.top_k, work, out)
+    for pos in (100, 5000, 123456):
+        ds.set(s, pos)
+        row.copy_(torch.randn_like(row))
+        g.replay()
+        torch.cuda.synchronize()
+        assert int(out.item()) == _host(row, None, s, pos)
diff --git a/tests/cuda/test_moe_decode_path.py b/tests/cuda/test_moe_decode_path.py
new file mode 100644
index 0000000..0476ecd
--- /dev/null
+++ b/tests/cuda/test_moe_decode_path.py
@@ -0,0 +1,81 @@
+"""The decode MoE path (one-launch routing, the swapped expert kernels, combine inside down) gives the old path's exact
+bits: every width, 1 to 14 rows, items past 8 and 16 pairs, call after call (the combine counters come back to zero),
+and replayed in a CUDA graph."""
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tensorfold.cuda import experts, moe  # noqa: E402
+
+from test_experts_lowbit import GS, as_bits, tensor  # noqa: E402
+
+WIDTHS = [(4, 4), (2, 3), (3, 3), (2, 2), (4, 2)]
+
+
+def block(bits_up, bits_down, e=24, d=512, ni=256, k=8, seed=0):
+    up = [as_bits(tensor(e, ni, d, bits_up, seed + 1 + i), bits_up) for i in range(2)]
+    down = as_bits(tensor(e, d, ni, bits_down, seed + 3), bits_down)
+    shared = ([as_bits(tensor(1, ni, d, 4, seed + 4 + i), 4) for i in range(2)],
+              as_bits(tensor(1, d, ni, 4, seed + 6), 4))
+    ex = experts.make(up, down, GS, limit=10.0, shared=shared)
+    g = torch.Generator(device="cuda").manual_seed(seed)
+    router = (torch.randn((e + 1, d), generator=g, device="cuda") * 0.05).to(torch.bfloat16)
+    return moe.Routed(router, ex, k)
+
+
+def old(monkeypatch):
+    for name, value in (("SELECT", False), ("COMBINE", 0), ("SPLIT", -1)):
+        monkeypatch.setattr(experts, name, value)
+
+
+def new(monkeypatch):
+    for name, value in (("SELECT", True), ("COMBINE", 64), ("SPLIT", 0)):
+        monkeypatch.setattr(experts, name, value)
+
+
+def both(m, x, monkeypatch):
+    old(monkeypatch)
+    want = moe.run(x, m)
+    new(monkeypatch)
+    return moe.run(x, m), want
+
+
+@pytest.mark.parametrize("bits_up,bits_down", WIDTHS)
+def test_decode_path_equals_old(bits_up, bits_down, monkeypatch):
+    m = block(bits_up, bits_down)
+    g = torch.Generator().manual_seed(bits_up * 10 + bits_down)
+    for rows in (1, 2, 3, 4, 6, 8, 14, 1, 4):
+        for _ in range(2):
+            x = (torch.randn((rows, 512), generator=g) * 0.5).to(torch.bfloat16).to("cuda")
+            got, want = both(m, x, monkeypatch)
+            assert torch.equal(got, want), rows
+
+
+def test_items_past_8_and_16_pairs(monkeypatch):
+    # 12 routed experts, top 8: up to 20 pairs on an expert (two passes; items split at 16), 20 on the shared one
+    m = block(2, 3, e=12)
+    g = torch.Generator().manual_seed(7)
+    for rows in (9, 14, 20, 12):
+        x = (torch.randn((rows, 512), generator=g) * 0.5).to(torch.bfloat16).to("cuda")
+        got, want = both(m, x, monkeypatch)
+        assert torch.equal(got, want), rows
+
+
+def test_decode_path_in_a_graph(monkeypatch):
+    m = block(4, 4, seed=20)
+    x = (torch.randn((4, 512), generator=torch.Generator().manual_seed(3)) * 0.5).to(torch.bfloat16).to("cuda")
+    old(monkeypatch)
+    want = [moe.run(x * s, m) for s in (1, 2, 3)]
+    new(monkeypatch)
+    xs = x.clone()
+    moe.run(xs, m)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        out = moe.run(xs, m)
+    for s, w in zip((1, 2, 3), want):
+        xs.copy_(x * s)
+        graph.replay()
+        assert torch.equal(out, w), s
