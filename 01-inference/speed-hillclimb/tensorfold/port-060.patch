diff --git a/src/tensorfold/cuda/kernels/keyed.cpp b/src/tensorfold/cuda/kernels/keyed.cpp
new file mode 100644
index 0000000..60442a7
--- /dev/null
+++ b/src/tensorfold/cuda/kernels/keyed.cpp
@@ -0,0 +1,31 @@
+#include <torch/extension.h>
+
+int64_t keyed_scratch_bytes();
+void keyed_draw_cuda(const at::Tensor&, const c10::optional<at::Tensor>&, const at::Tensor&, const at::Tensor&,
+                     int64_t, int64_t, at::Tensor&, at::Tensor&);
+
+// One row's keyed draw into ``out`` (int64 [1], the column drawn); no host wait, so a graph can capture it.
+// ``scratch``: ``scratch_bytes()`` zeroed bytes on the device, left zero by each launch.
+void draw(const at::Tensor& row, const c10::optional<at::Tensor>& ids, const at::Tensor& ints,
+          const at::Tensor& floats, int64_t step, int64_t top_k, at::Tensor scratch, at::Tensor out) {
+    TORCH_CHECK(row.is_cuda() && row.is_contiguous() && row.dim() == 1 &&
+                (row.scalar_type() == at::kBFloat16 || row.scalar_type() == at::kFloat),
+                "row: one contiguous bf16 or fp32 row on the device");
+    TORCH_CHECK(row.numel() < (1 << 24), "rows of under 16M columns");
+    if (ids.has_value())
+        TORCH_CHECK(ids->is_cuda() && ids->is_contiguous() && ids->scalar_type() == at::kLong &&
+                    ids->numel() == row.numel(), "ids: int64, one per column");
+    TORCH_CHECK(ints.is_cuda() && ints.scalar_type() == at::kLong && ints.numel() == 2, "ints: (seed, first)");
+    TORCH_CHECK(floats.is_cuda() && floats.scalar_type() == at::kDouble && floats.numel() == 3,
+                "floats: (temperature, top_p, ln min_p)");
+    TORCH_CHECK(top_k >= 1 && top_k <= 256, "top_k in 1..256");
+    TORCH_CHECK(scratch.is_cuda() && scratch.nbytes() >= static_cast<size_t>(keyed_scratch_bytes()),
+                "scratch: scratch_bytes() on the device");
+    TORCH_CHECK(out.is_cuda() && out.scalar_type() == at::kLong && out.numel() == 1, "out: int64 [1]");
+    keyed_draw_cuda(row, ids, ints, floats, step, top_k, scratch, out);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("draw", &draw, "the keyed top_k/top_p/min_p draw of one row");
+    m.def("scratch_bytes", &keyed_scratch_bytes, "the bytes of scratch a draw needs");
+}
