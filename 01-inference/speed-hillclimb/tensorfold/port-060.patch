@@ -0,0 +1,105 @@
+"""Conversations another prompt evicts are parked in host memory and copied back: a returning conversation resumes
+where it was, without prefilling again, and decodes exactly as serial decoding does."""
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tensorfold.families.qwen3_5_moe.cuda import decode, swap as swap_mod  # noqa: E402
+from tensorfold.families.qwen3_5_moe.cuda.swap import Swap  # noqa: E402
+from tensorfold.families.qwen3_5.cuda.engine import entry_end  # noqa: E402
+
+from test_qwen36_moe import SAMPLINGS, _model, _serial  # noqa: E402
+from test_qwen36_moe_arena import _engine  # noqa: E402
+
+
+@pytest.fixture(autouse=True)
+def small_chunks(monkeypatch):
+    monkeypatch.setattr(swap_mod, "ROWS", 16)            # prompts span several chunks, so snapshots share some
+    monkeypatch.setattr(swap_mod, "GAP", 4)
+
+
+def _swapping(w, head, budget=1 << 30):
+    e = _engine(w, head)
+    e.swap = Swap(e.graphs, budget)
+    return e
+
+
+def _generate(e, prompt, sampling, count):
+    out = []
+    stats = e.generate(prompt, count, sampling, lambda toks: out.extend(toks) and False, stop_eos=False)
+    return out[:count], stats
+
+
+def _hold_a_fresh_prefill(w, head, e):
+    """Every kept prefix, copied back or not, holds the rows and states a fresh prefill of its ids gives (the tiny test
+    model's tokens barely depend on the context, so equal tokens alone would not show it)."""
+
+    for ids, st, (mc, held) in e.cache.entries:
+        fresh, fmc, _, carry = decode.prefill(w, head, ids, None)
+        n = len(ids)
+        for kv, fkv in zip(st.kv, fresh.kv):
+            if kv is not None:
+                assert torch.equal(kv[0][:n], fkv[0][:n]) and torch.equal(kv[1][:n], fkv[1][:n])
+        assert torch.equal(mc.k[:n - 1], fmc.k[:n - 1]) and torch.equal(mc.v[:n - 1], fmc.v[:n - 1])
+        for x, y in zip(st.rec + st.conv, fresh.rec + fresh.conv):
+            assert (x is None) == (y is None) and (x is None or torch.equal(x, y))
+        assert st.pos == n and mc.pos == n - 1 and torch.equal(held, carry.states)
+
+
+@pytest.mark.parametrize("sampling", SAMPLINGS[:2])
+def test_interleaved_conversations_resume_from_host_and_equal_serial(sampling):
+    w, head = _model()
+    e = _swapping(w, head)
+    system = list(range(100, 120))
+    a = system + [(i * 7) % 90 + 3 for i in range(45)]
+    b = system + [(i * 11) % 90 + 3 for i in range(38)]
+    a2, b2 = a + [5, 6, 7] * 6, b + [9, 8] * 10
+    a3 = a2 + [4] * 21
+    # kept prefixes sit at prompt entry ends here (no message markers), so a returning conversation comes back whole
+    # but its last token
+    turns = [(a, 0), (b, 0), (a2, entry_end(a)), (b2, entry_end(b)), (a3, entry_end(a2)), (a3 + [1, 2], 0)]
+    first = None
+    for i, (prompt, back) in enumerate(turns):
+        got, stats = _generate(e, prompt, sampling, 20)
+        assert got == _serial(w, prompt, sampling, 20)[:20], i
+        assert stats["swapped_in"] == back, i
+        if back:
+            assert stats["cached"] == back
+        _hold_a_fresh_prefill(w, head, e)
+        if i == 2:
+            first = next(s for s in e.swap.snaps if s.ids == a[:-1]).chunks[0][0].data_ptr()
+        if i == 3:        # parked again, longer: the full chunks it already had are shared, the shorter snapshot gone
+            longer = next(s for s in e.swap.snaps if s.ids == a2[:-1])
+            assert longer.chunks[0][0].data_ptr() == first
+            assert not any(s.ids == a[:-1] for s in e.swap.snaps)
+    assert sorted(len(s.ids) for s in e.swap.snaps) == sorted([entry_end(a2), entry_end(b2)])
+
+
+def test_a_parked_state_holds_what_a_fresh_prefill_writes():
+    w, head = _model()
+    e = _swapping(w, head)
+    a, b = list(range(30, 90)), list(range(150, 190))
+    _generate(e, a, None, 8)
+    _generate(e, b, None, 8)
+    (snap,) = e.swap.snaps
+    a = a[:entry_end(a)]                                 # the kept entry: the prompt but its last token
+    assert snap.ids == a
+    fresh, fmc, _, carry = decode.prefill(w, head, a, None)
+    k = torch.cat(snap.chunks[0]).cuda()
+    hk = torch.cat(snap.chunks[-2]).cuda()
+    assert torch.equal(k, fresh.kv[1][0][:len(a)]) and torch.equal(hk, fmc.k[:len(a) - 1])
+    assert all(torch.equal(x.cuda(), y) for x, y in zip(snap.rec, fresh.rec) if x is not None)
+    assert torch.equal(snap.held.cuda(), carry.states)
+
+
+def test_over_budget_nothing_is_parked_and_requests_still_equal_serial():
+    w, head = _model()
+    e = _swapping(w, head, budget=1)
+    a, b = list(range(30, 70)), list(range(150, 180))
+    for prompt in (a, b, a + [3] * 10):
+        got, stats = _generate(e, prompt, None, 12)
+        assert got == _serial(w, prompt, None, 12)[:12] and stats["swapped_in"] == 0
+    assert e.swap.snaps == []
