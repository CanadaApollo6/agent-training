+"""The decode router's tiles (16 experts a program) give the old tiles' logits (32 a program) bit for bit: a row's
+chain of K steps is the same whatever the tile."""
+
+import pytest
+import torch
+import triton
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tensorfold.cuda import moe  # noqa: E402
+
+
+def _old(x, w):
+    m, d = x.shape
+    ne = w.shape[0]
+    out = torch.empty((m, ne), dtype=torch.float32, device=x.device)
+    moe._router[(1, triton.cdiv(ne, 32))](x, w, out, m, x.stride(0), D=d, NE=ne, BM=16, BLOCK_E=32, BK=256,
+                                           num_warps=4, num_stages=4)
+    return out
+
+
+@pytest.mark.parametrize("ne,d", [(257, 2048), (25, 512), (17, 256)])
+def test_decode_router_equals_the_old_tiles(ne, d):
+    g = torch.Generator(device="cuda").manual_seed(ne)
+    w = (torch.randn((ne, d), device="cuda", generator=g) * 0.02).to(torch.bfloat16)
+    for rows in (1, 2, 3, 4, 7, 16, 1):
+        for _ in range(4):
+            x = torch.randn((rows, d), device="cuda", generator=g).to(torch.bfloat16)
+            assert torch.equal(moe.router(x, w).view(torch.int32), _old(x, w).view(torch.int32)), (ne, rows)
