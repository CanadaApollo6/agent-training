@@ -0,0 +1,128 @@
+"""Evicted conversations parked in pinned host memory and copied back when they return, instead of prefilled again.
+
+The engine holds one set of attention rows, so a prompt that doesn't extend the kept prefixes overwrites them. Before
+it does, each kept prefix it drops is copied out here: its attention and head-cache rows, its GDN states and its held
+row. A later prompt that extends one gets it copied back, the rows it already shares with the GPU's kept prefix left
+in place. Prefill rows have the same bits whatever the chunking, so a copy back equals prefilling again, bit for bit.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+import torch
+
+ROWS = 2048          # rows per host chunk: 2 MiB a source at 1 KiB a row, a size the pinned allocator doesn't round
+GAP = 64             # a parked prefix is copied back only when it is this many tokens past the GPU's kept prefix
+
+
+@dataclass
+class Snapshot:
+    """A kept prefix in host memory: ``chunks[s]`` holds source ``s``'s rows ``ROWS`` at a time (the last may be short)."""
+
+    ids: list[int]
+    pos: int
+    mc_pos: int
+    rec: list[torch.Tensor | None]
+    conv: list[torch.Tensor | None]
+    held: torch.Tensor | None
+    chunks: list[list[torch.Tensor]] = field(default_factory=list)
+
+
+def _common(a: list[int], b: list[int]) -> int:
+    n = min(len(a), len(b))
+    i = 0
+    while i < n and a[i] == b[i]:
+        i += 1
+    return i
+
+
+def _host(t: torch.Tensor) -> torch.Tensor:
+    out = torch.empty(t.shape, dtype=t.dtype, pin_memory=True)
+    out.copy_(t, non_blocking=True)
+    return out
+
+
+class Swap:
+    """Parked prefixes, newest last, within ``budget`` bytes of pinned memory (chunks shared between snapshots count once)."""
+
+    def __init__(self, graphs, budget: int) -> None:
+        self.graphs, self.budget = graphs, int(budget)
+        self.snaps: list[Snapshot] = []
+
+    def _sources(self) -> list[tuple[torch.Tensor, bool]]:
+        """The shared row buffers, each with whether it is the head's (its rows run one behind the target's)."""
+
+        out = []
+        for kv in self.graphs.st.kv:
+            if kv is not None:
+                out += [(kv[0], False), (kv[1], False)]
+        return out + [(self.graphs.mc.k, True), (self.graphs.mc.v, True)]
+
+    def used(self) -> int:
+        seen: dict[int, int] = {}
+        for s in self.snaps:
+            for t in [*s.rec, *s.conv, s.held, *(c for cs in s.chunks for c in cs)]:
+                if t is not None:
+                    seen[t.data_ptr()] = t.untyped_storage().nbytes()
+        return sum(seen.values())
+
+    def save(self, ids: list[int], st, mc, held: torch.Tensor | None) -> Snapshot:
+        """Copy a kept prefix out, reusing the full chunks a parked snapshot already holds for the same leading ids."""
+
+        donor, shared = None, 0
+        for s in self.snaps:
+            c = _common(s.ids, ids)
+            if c > shared:
+                donor, shared = s, c
+        snap = Snapshot(list(ids), st.pos, mc.pos, [None if t is None else _host(t) for t in st.rec],
+                        [None if t is None else _host(t) for t in st.conv], None if held is None else _host(held))
+        for i, (buf, head) in enumerate(self._sources()):
+            rows = snap.mc_pos if head else snap.pos
+            same = shared - 1 if head else shared          # a head row also reads the next token
+            if donor is not None:
+                same = min(same, donor.mc_pos if head else donor.pos)
+            out = []
+            for j in range(-(-rows // ROWS)):
+                a, b = j * ROWS, min(rows, (j + 1) * ROWS)
+                if donor is not None and b - a == ROWS and b <= same:
+                    out.append(donor.chunks[i][j])
+                else:
+                    out.append(_host(buf[a:b]))
+            snap.chunks.append(out)
+        # a snapshot the new one extends is covered by it (agents append), so it goes
+        self.snaps = [s for s in self.snaps if not (len(s.ids) <= len(ids) and ids[:len(s.ids)] == s.ids)] + [snap]
+        while self.snaps and self.used() > self.budget:
+            self.snaps.pop(0)
+        return snap
+
+    def find(self, prompt: list[int]) -> Snapshot | None:
+        """The longest parked prefix the prompt strictly extends, now newest."""
+
+        best = None
+        for s in self.snaps:
+            if len(s.ids) < len(prompt) and (best is None or len(s.ids) > len(best.ids)) and \
+                    list(prompt[:len(s.ids)]) == s.ids:
+                best = s
+        if best is not None:
+            self.snaps = [s for s in self.snaps if s is not best] + [best]
+        return best
+
+    def restore(self, snap: Snapshot, rows: int, head_rows: int):
+        """Copy a snapshot back into the shared buffers past the first ``rows`` target and ``head_rows`` head rows (which
+        the GPU already holds for the same ids), and its states into a fresh prompt state: ``(state, head cache, held)``."""
+
+        for i, (buf, head) in enumerate(self._sources()):
+            end, lo = (snap.mc_pos, head_rows) if head else (snap.pos, rows)
+            for j, chunk in enumerate(snap.chunks[i]):
+                a, b = j * ROWS, min(end, (j + 1) * ROWS)
+                if b > lo:
+                    s = max(a, lo)
+                    buf[s:b].copy_(chunk[s - a:b - a], non_blocking=True)
+        st, mc = self.graphs.fresh()
+        for dst, src in zip(st.rec + st.conv, snap.rec + snap.conv):
+            if dst is not None:
+                dst.copy_(src, non_blocking=True)
+        st.pos, mc.pos = snap.pos, snap.mc_pos
+        held = None if snap.held is None else snap.held.to(self.graphs.mc.k.device, non_blocking=True)
+        return st, mc, held
