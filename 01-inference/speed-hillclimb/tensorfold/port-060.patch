index 0000000..f9327d5
--- /dev/null
+++ b/tests/cuda/test_qmm_seg.py
@@ -0,0 +1,95 @@
+"""The segmented decode launch (several weights of one input, each with its own K slices, the slices added inside the
+launch) gives each weight's single-launch bits: the reduce kernel's slice order, rounded once."""
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tensorfold.cuda.kernels import qmm  # noqa: E402
+
+if not qmm.segmented(torch.empty((1, 64), device="cuda"), ()):
+    pytest.skip("GPUs with clusters add K slices in clusters", allow_module_level=True)
+
+
+@pytest.fixture(params=[False, True], ids=["tokens-as-A", "weights-as-A"], autouse=True)
+def swap(request, monkeypatch):
+    monkeypatch.setattr(qmm, "SWAP", request.param)
+    return request.param
+
+
+def _weight(n, k, g):
+    w = torch.randint(-2 ** 31, 2 ** 31 - 1, (n, k // 8), device="cuda", dtype=torch.int32, generator=g)
+    s = (torch.rand((n, k // 64), device="cuda", generator=g) * 0.02).to(torch.bfloat16)
+    b = (torch.randn((n, k // 64), device="cuda", generator=g) * 0.05).to(torch.bfloat16)
+    return qmm.pack(w, s, b, 64)
+
+
+def _old(x, q, xs, f32):
+    """The two-launch path: slices to a buffer, then reduce_kernel."""
+    sk = qmm.split_k(q.n, q.k, q.gs)
+    out = torch.empty((x.shape[0], q.n), dtype=torch.float32 if f32 else torch.bfloat16, device=x.device)
+    qmm._ext().qmm(x, xs, q.weight, q.scales, q.biases, out, None, q.n, sk, q.gs, qmm.bucket(x.shape[0]), f32, True)
+    return out
+
+
+def _same(a, b):
+    return torch.equal(a.view(torch.int16 if a.dtype == torch.bfloat16 else torch.int32),
+                       b.view(torch.int16 if b.dtype == torch.bfloat16 else torch.int32))
+
+
+@pytest.mark.parametrize("shapes", [
+    [(8192, 2048), (4096, 2048), (32, 2048), (32, 2048)],      # a GDN layer's qkv, z, b, a
+    [(8192, 2048), (512, 2048), (512, 2048)],                   # attention q, k, v
+    [(2048, 4096)],                                             # o / out (8 slices)
+    [(1000, 2048), (33, 2048), (130, 2048), (4160, 2048), (64, 2048)],   # ragged widths, more than 4 weights
+])
+@pytest.mark.parametrize("f32", [False, True])
+def test_segmented_equals_single_launches(shapes, f32):
+    g = torch.Generator(device="cuda").manual_seed(len(shapes))
+    k = shapes[0][1]
+    qs = [_weight(n, kk, g) for n, kk in shapes]
+    for m in (1, 2, 3, 4, 5, 8, 13, 16):
+        x = (torch.randn((m, k), device="cuda", generator=g) * 2).to(torch.bfloat16)
+        xs = qmm.group_sums(x)
+        for _ in range(2):                                      # counters are back at zero after a launch
+            got = qmm.matmul_many(x, qs, xs, f32=f32)
+            for q, o in zip(qs, got):
+                assert _same(o, _old(x, q, xs, f32)), (m, q.n)
+
+
+def test_single_matmul_takes_the_fused_reduce_and_replays_in_a_graph():
+    g = torch.Generator(device="cuda").manual_seed(7)
+    q = _weight(2048, 4096, g)
+    x = torch.randn((4, 4096), device="cuda", generator=g).to(torch.bfloat16)
+    xs = qmm.group_sums(x)
+    ref = _old(x, q, xs, False)
+    assert _same(qmm.matmul(x, q, xs), ref)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        out = qmm.matmul(x, q, xs)
+    for _ in range(3):
+        out.zero_()
+        graph.replay()
+        assert _same(out, ref)
+
+
+def test_strided_scales_of_a_row_block():
+    g = torch.Generator(device="cuda").manual_seed(3)
+    full = _weight(1024, 2048, g)
+    part = qmm.Q4(full.weight[2:10], full.scales[:, 128:640], full.biases[:, 128:640], 512, 2048, 64)
+    x = torch.randn((3, 2048), device="cuda", generator=g).to(torch.bfloat16)
+    xs = qmm.group_sums(x)
+    assert _same(qmm.matmul_many(x, [part], xs)[0], _old(x, part, xs, False))
+
+
+@pytest.mark.parametrize("n,k", [(8200, 2048), (2048, 4096), (33, 512)])
+def test_single_matmul_at_decode_rows_equals_the_old_kernel(n, k):
+    g = torch.Generator(device="cuda").manual_seed(n)
+    q = _weight(n, k, g)
+    for m in (1, 2, 5, 8, 9, 16):
+        x = torch.randn((m, k), device="cuda", generator=g).to(torch.bfloat16)
+        xs = qmm.group_sums(x)
+        for f32 in (False, True):
+            assert _same(qmm.matmul(x, q, xs, f32=f32), _old(x, q, xs, f32)), (m, f32)
