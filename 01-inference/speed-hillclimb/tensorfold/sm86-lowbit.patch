+++ w/tests/cuda/test_moe_router.py
@@ -0,0 +1,30 @@
+"""The decode router's tiles (16 experts a program) give the old tiles' logits (32 a program) bit for bit: a row's
+chain of K steps is the same whatever the tile."""
+
+import pytest
+import torch
+import triton
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tensorfold.cuda import moe  # noqa: E402
+
+
+def _old(x, w):
+    m, d = x.shape
+    ne = w.shape[0]
+    out = torch.empty((m, ne), dtype=torch.float32, device=x.device)
+    moe._router[(1, triton.cdiv(ne, 32))](x, w, out, m, x.stride(0), D=d, NE=ne, BM=16, BLOCK_E=32, BK=256,
+                                           num_warps=4, num_stages=4)
+    return out
+
+
+@pytest.mark.parametrize("ne,d", [(257, 2048), (25, 512), (17, 256)])
+def test_decode_router_equals_the_old_tiles(ne, d):
+    g = torch.Generator(device="cuda").manual_seed(ne)
+    w = (torch.randn((ne, d), device="cuda", generator=g) * 0.02).to(torch.bfloat16)
+    for rows in (1, 2, 3, 4, 7, 16, 1):
+        for _ in range(4):
+            x = torch.randn((rows, d), device="cuda", generator=g).to(torch.bfloat16)
+            assert torch.equal(moe.router(x, w).view(torch.int32), _old(x, w).view(torch.int32)), (ne, rows)
diff --git i/tests/cuda/test_moe_select.py w/tests/cuda/test_moe_select.py
new file mode 100644
index 0000000..3c3dfc8
--- /dev/null
+++ w/tests/cuda/test_moe_select.py
@@ -0,0 +1,40 @@
+"""Decode routing in one launch (experts.select) gives moe._topk_rows's picks and weights and plan's members, items and
+counts, bit for bit: ties to the lower id, 1 to 28 rows, 256 or 24 experts, items split past 16 pairs."""
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tensorfold.cuda import experts, moe  # noqa: E402
+
+
+class _Cfg:
+    def __init__(self, e, k):
+        self.num_experts, self.num_experts_per_tok = e, k
+        self.moe_intermediate_size, self.hidden_size = 64, 64
+
+
+@pytest.mark.parametrize("e,k", [(256, 8), (24, 8), (64, 4)])
+def test_select_equals_topk_then_plan(e, k, monkeypatch):
+    g = torch.Generator(device="cuda").manual_seed(e + k)
+    for rows in (1, 2, 4, 7, 16, 28, 60):
+        if rows * (k + 1) > 256:
+            continue
+        logits = torch.randn((rows, e + 1), generator=g, device="cuda") * 3
+        if rows % 2 == 0:
+            logits = torch.round(logits * 2) / 2                   # many equal logits: ties go to the lower id
+        a = moe.MoEBuffers(rows, _Cfg(e, k), "cuda")
+        b = moe.MoEBuffers(rows, _Cfg(e, k), "cuda")
+        monkeypatch.setattr(experts, "SELECT", False)
+        moe.select(logits, a, k, e)
+        monkeypatch.setattr(experts, "SELECT", True)
+        moe.select(logits, b, k, e)
+        assert torch.equal(a.pick[:rows], b.pick[:rows]), rows
+        assert torch.equal(a.wts[:rows].view(torch.int32), b.wts[:rows].view(torch.int32)), rows
+        p = rows * (k + 1)
+        assert torch.equal(a.plan.members[:p], b.plan.members[:p]), rows
+        assert torch.equal(a.plan.counts, b.plan.counts), rows
+        n = int(a.plan.counts[0])
+        assert torch.equal(a.plan.items[:n], b.plan.items[:n]), rows
diff --git i/tests/cuda/test_qwen36_moe_arena.py w/tests/cuda/test_qwen36_moe_arena.py
new file mode 100644
index 0000000..3d6f95d
--- /dev/null
+++ w/tests/cuda/test_qwen36_moe_arena.py
@@ -0,0 +1,77 @@
+"""The MoE engine holds the context once: prompts prefill into the decode graphs' buffers, kept prompt states live
+there too, and every request still equals serial decoding whatever came before it."""
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tensorfold.cuda.streams import PrefixCache  # noqa: E402
+from tensorfold.families.qwen3_5_moe.cuda import decode, engine as engine_mod  # noqa: E402
+from tensorfold.families.qwen3_5_moe.cuda.graphs import Graphs  # noqa: E402
+
+from test_qwen36_moe import SAMPLINGS, _model, _serial  # noqa: E402
+
+WINDOW = 512
+
+
+def _engine(w, head, depth=3):
+    e = object.__new__(engine_mod.Qwen36Engine)
+    e.w, e.head, e.depth, e.confidence = w, head, depth, engine_mod.CONFIDENCE
+    e.context_window = WINDOW
+    e.graphs = Graphs(w, head, WINDOW + depth + 1)
+    e.graphs.grow(e.graphs.capacity, exact=True)
+    e.eos, e.points, e.cache = (), None, PrefixCache(engine_mod.KEEP)
+    return e
+
+
+def _run(e, prompt, sampling, count):
+    out = []
+    e.generate(prompt, count, sampling, lambda toks: out.extend(toks) and False, stop_eos=False)
+    return out[:count]
+
+
+@pytest.mark.parametrize("sampling", SAMPLINGS[:2])
+def test_requests_equal_serial_whatever_came_before(sampling):
+    w, head = _model()
+    e = _engine(w, head)
+    a = list(range(20, 60))
+    b = [7, 9, 11] * 9
+    turns = [a, a + [3, 4, 5, 6] * 5, b, a + [3, 4, 5, 6] * 5, a[:25], a + [8] * 30]
+    rows = e.graphs.st.kv[1][0].data_ptr()
+    for prompt in turns:
+        got = _run(e, prompt, sampling, 24)
+        assert got == _serial(w, prompt, sampling, 24)[:24], prompt[:8]
+        # the kept states are prefixes of the last prompt, in the one set of buffers
+        assert all(prompt[:len(ids)] == ids for ids, _, _ in e.cache.entries)
+        assert all(st.kv[1][0].data_ptr() == rows for _, st, _ in e.cache.entries)
+        for ids, st, (mc, _) in e.cache.entries:           # and hold exactly what a fresh prefill of them writes
+            fresh, fmc, _, _ = decode.prefill(w, head, ids, None)
+            n = len(ids)
+            assert torch.equal(st.kv[1][0][:n], fresh.kv[1][0][:n]) and torch.equal(st.kv[1][1][:n], fresh.kv[1][1][:n])
+            assert torch.equal(mc.k[:n - 1], fmc.k[:n - 1]) and torch.equal(mc.v[:n - 1], fmc.v[:n - 1])
+    assert e.graphs.st.kv[1][0].data_ptr() == rows            # never regrown
+
+
+def test_a_resumed_request_reuses_the_prefix():
+    w, head = _model()
+    e = _engine(w, head)
+    a = list(range(20, 60))
+    stats = []
+    for prompt in (a, a + [1, 2, 3] * 4):
+        out = []
+        stats.append(e.generate(prompt, 8, None, lambda toks: out.extend(toks) and False, stop_eos=False))
+    assert stats[1]["cached"] == len(a)
+
+
+def test_the_head_absorbs_a_long_prompt_in_pieces(monkeypatch):
+    w, head = _model()
+    prompt = [(i * 37) % 250 + 3 for i in range(420)]
+    want = _serial(w, prompt, None, 16)[:16]
+    whole = decode.prefill(w, head, prompt, None)
+    monkeypatch.setattr(decode, "HEAD_ROWS", 150)          # 3 pieces of 139-140 rows, each past MAX_NODES
+    e = _engine(w, head)
+    assert _run(e, prompt, None, 16) == want
+    pieces = decode.prefill(w, head, prompt, None)
+    assert pieces[1].pos == whole[1].pos == len(prompt) - 1 and pieces[2] == whole[2]
