index 0000000..c28ce0d
--- /dev/null
+++ w/tests/cuda/test_experts_split.py
@@ -0,0 +1,52 @@
+"""The decode kernel (weights as the mma's A, S warps sharing a unit's groups, then folding them in order) gives the
+one-warp reference kernel's exact bits: every width, 1 to 16 rows (items past 8 pairs take two passes), groups that
+don't divide by S, the 4-bit shared expert beside narrow ones."""
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tensorfold.cuda import experts  # noqa: E402
+
+from test_experts_lowbit import GS, as_bits, picks_for, run, tensor  # noqa: E402
+
+WIDTHS = [(4, 4), (3, 3), (2, 3), (2, 2), (4, 2)]
+
+
+def layer(bits_up, bits_down, e=18, d=320, ni=192):
+    """d = 5 groups (gate/up), ni = 3 groups (down): rounds of 2, 4 and 8 warps end part full."""
+
+    up = [as_bits(tensor(e, ni, d, bits_up, 50 + i), bits_up) for i in range(2)]
+    down = as_bits(tensor(e, d, ni, bits_down, 60), bits_down)
+    shared = ([as_bits(tensor(1, ni, d, 4, 70 + i), 4) for i in range(2)], as_bits(tensor(1, d, ni, 4, 80), 4))
+    return experts.make(up, down, GS, limit=10.0, shared=shared)
+
+
+@pytest.mark.parametrize("bits_up,bits_down", WIDTHS)
+def test_split_equals_one_warp(bits_up, bits_down, monkeypatch):
+    ex = layer(bits_up, bits_down)
+    g = torch.Generator().manual_seed(bits_up * 10 + bits_down)
+    for rows in (1, 2, 3, 6, 16):
+        x = (torch.randn((rows, ex.dims), generator=g) * 0.5).to(torch.bfloat16).to("cuda")
+        picks = picks_for(rows, 18, seed=rows)
+        monkeypatch.setattr(experts, "SPLIT", -1)
+        want = run(ex, x, picks)
+        for split in (0, 1, 2, 4, 8):
+            monkeypatch.setattr(experts, "SPLIT", split)
+            got = run(ex, x, picks)
+            assert torch.equal(got[0], want[0]) and torch.equal(got[1], want[1]), (rows, split)
+
+
+def test_relu2_split_equals_one_warp(monkeypatch):
+    up = [as_bits(tensor(12, 128, 256, 4, 90), 4)]
+    ex = experts.make(up, as_bits(tensor(12, 256, 128, 4, 91), 4), GS)
+    x = (torch.randn((4, 256), generator=torch.Generator().manual_seed(3)) * 0.5).to(torch.bfloat16).to("cuda")
+    picks = picks_for(4, 12, k=5)[:, :5].contiguous()
+    monkeypatch.setattr(experts, "SPLIT", -1)
+    want = run(ex, x, picks)
+    for split in (0, 1, 2, 4):
+        monkeypatch.setattr(experts, "SPLIT", split)
+        got = run(ex, x, picks)
+        assert torch.equal(got[0], want[0]) and torch.equal(got[1], want[1]), split
diff --git i/tests/cuda/test_moe_decode_path.py w/tests/cuda/test_moe_decode_path.py
new file mode 100644
index 0000000..0476ecd
--- /dev/null
+++ w/tests/cuda/test_moe_decode_path.py
@@ -0,0 +1,81 @@
+"""The decode MoE path (one-launch routing, the swapped expert kernels, combine inside down) gives the old path's exact
+bits: every width, 1 to 14 rows, items past 8 and 16 pairs, call after call (the combine counters come back to zero),
+and replayed in a CUDA graph."""
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tensorfold.cuda import experts, moe  # noqa: E402
+
+from test_experts_lowbit import GS, as_bits, tensor  # noqa: E402
+
+WIDTHS = [(4, 4), (2, 3), (3, 3), (2, 2), (4, 2)]
+
+
+def block(bits_up, bits_down, e=24, d=512, ni=256, k=8, seed=0):
+    up = [as_bits(tensor(e, ni, d, bits_up, seed + 1 + i), bits_up) for i in range(2)]
+    down = as_bits(tensor(e, d, ni, bits_down, seed + 3), bits_down)
+    shared = ([as_bits(tensor(1, ni, d, 4, seed + 4 + i), 4) for i in range(2)],
+              as_bits(tensor(1, d, ni, 4, seed + 6), 4))
+    ex = experts.make(up, down, GS, limit=10.0, shared=shared)
+    g = torch.Generator(device="cuda").manual_seed(seed)
+    router = (torch.randn((e + 1, d), generator=g, device="cuda") * 0.05).to(torch.bfloat16)
+    return moe.Routed(router, ex, k)
+
+
+def old(monkeypatch):
+    for name, value in (("SELECT", False), ("COMBINE", 0), ("SPLIT", -1)):
+        monkeypatch.setattr(experts, name, value)
+
+
+def new(monkeypatch):
+    for name, value in (("SELECT", True), ("COMBINE", 64), ("SPLIT", 0)):
+        monkeypatch.setattr(experts, name, value)
+
+
+def both(m, x, monkeypatch):
+    old(monkeypatch)
+    want = moe.run(x, m)
+    new(monkeypatch)
+    return moe.run(x, m), want
+
+
+@pytest.mark.parametrize("bits_up,bits_down", WIDTHS)
+def test_decode_path_equals_old(bits_up, bits_down, monkeypatch):
+    m = block(bits_up, bits_down)
+    g = torch.Generator().manual_seed(bits_up * 10 + bits_down)
+    for rows in (1, 2, 3, 4, 6, 8, 14, 1, 4):
+        for _ in range(2):
+            x = (torch.randn((rows, 512), generator=g) * 0.5).to(torch.bfloat16).to("cuda")
+            got, want = both(m, x, monkeypatch)
+            assert torch.equal(got, want), rows
+
+
+def test_items_past_8_and_16_pairs(monkeypatch):
+    # 12 routed experts, top 8: up to 20 pairs on an expert (two passes; items split at 16), 20 on the shared one
+    m = block(2, 3, e=12)
+    g = torch.Generator().manual_seed(7)
+    for rows in (9, 14, 20, 12):
+        x = (torch.randn((rows, 512), generator=g) * 0.5).to(torch.bfloat16).to("cuda")
+        got, want = both(m, x, monkeypatch)
+        assert torch.equal(got, want), rows
+
+
+def test_decode_path_in_a_graph(monkeypatch):
+    m = block(4, 4, seed=20)
+    x = (torch.randn((4, 512), generator=torch.Generator().manual_seed(3)) * 0.5).to(torch.bfloat16).to("cuda")
+    old(monkeypatch)
+    want = [moe.run(x * s, m) for s in (1, 2, 3)]
+    new(monkeypatch)
+    xs = x.clone()
+    moe.run(xs, m)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        out = moe.run(xs, m)
+    for s, w in zip((1, 2, 3), want):
+        xs.copy_(x * s)
+        graph.replay()
+        assert torch.equal(out, w), s
diff --git i/tests/cuda/test_moe_router.py w/tests/cuda/test_moe_router.py
new file mode 100644
index 0000000..d62abd4
