+
+def mlx_words(q: torch.Tensor, bits: int) -> torch.Tensor:
+    """Levels [..., K] -> MLX words [..., K * bits / 32]: an LSB-first bitstream (as mx.quantize packs)."""
+
+    bitsarr = ((q.to(torch.int64)[..., None] >> torch.arange(bits, device=q.device)) & 1).reshape(*q.shape[:-1], -1, 32)
+    v = (bitsarr << torch.arange(32, device=q.device)).sum(-1)
+    return torch.where(v >= 2 ** 31, v - 2 ** 32, v).to(torch.int32)
+
+
+def tensor(e: int, n: int, k: int, bits: int, seed: int):
+    g = torch.Generator(device=DEV).manual_seed(seed)
+    q = torch.randint(0, 2 ** bits, (e, n, k), generator=g, device=DEV)
+    scales = (torch.rand((e, n, k // GS), generator=g, device=DEV) * 0.02 + 0.001).to(torch.bfloat16)
+    biases = (torch.randn((e, n, k // GS), generator=g, device=DEV) * 0.02).to(torch.bfloat16)
+    return q, scales, biases
+
+
+def as_bits(t, bits: int):
+    q, s, b = t
+    return mlx_words(q, bits), s, b
+
+
+def test_levels_round_trip():
+    for bits in (2, 3, 4):
+        q, _, _ = tensor(3, 32, 256, bits, bits)
+        assert torch.equal(experts.levels(mlx_words(q, bits), bits).long(), q)
+
+
+def run(ex, x, picks, *, prefill=False, y_dtype=torch.float32):
+    rows, slots = picks.shape
+    plan = experts.Plan(rows, slots, ex.count, DEV, prefill=prefill)
+    experts.route(picks.contiguous(), plan)
+    act = torch.empty((rows * slots, ex.width), dtype=torch.bfloat16, device=DEV)
+    y = torch.empty((rows * slots, ex.dims), dtype=y_dtype, device=DEV)
+    experts.gate_up(x, ex, plan, act, rows)
+    experts.down(act, ex, plan, y, rows)
+    return act, y
+
+
+def pair(bits_up, bits_down, e=18, d=512, ni=128):
+    """The same levels twice: narrow experts with a 4-bit shared expert beside them, and all at 4 bits."""
+
+    up = [tensor(e, ni, d, bits_up, 10 + i) for i in range(2)]
+    down = tensor(e, d, ni, bits_down, 20)
+    s_up = [tensor(1, ni, d, 4, 30 + i) for i in range(2)]
+    s_down = tensor(1, d, ni, 4, 40)
+    narrow = experts.make([as_bits(t, bits_up) for t in up], as_bits(down, bits_down), GS, limit=10.0,
+                          shared=([as_bits(t, 4) for t in s_up], as_bits(s_down, 4)))
+    cat = lambda t, st: tuple(torch.cat([a, b]) for a, b in zip(t, st))  # noqa: E731
+    full = experts.make([as_bits(cat(t, st), 4) for t, st in zip(up, s_up)], as_bits(cat(down, s_down), 4), GS,
+                        limit=10.0)
+    return narrow, full
+
+
+def picks_for(rows, e, k=6, seed=5):
+    g = torch.Generator().manual_seed(seed)
+    return torch.stack([torch.cat([torch.randperm(e, generator=g)[:k], torch.tensor([e])])
+                        for _ in range(rows)]).to(torch.int32).to(DEV)
+
+
+WIDTHS = [(2, 3), (3, 3), (2, 2), (3, 4), (4, 2)]
+
+
+@pytest.mark.parametrize("prefill,y_dtype", [(False, torch.float32), (True, torch.float32), (True, torch.bfloat16)])
+@pytest.mark.parametrize("bits_up,bits_down", WIDTHS)
+def test_narrow_experts_match_the_4bit_kernels(bits_up, bits_down, prefill, y_dtype):
+    narrow, full = pair(bits_up, bits_down)
+    assert (narrow.bits_up, narrow.bits_down) == (bits_up, bits_down) and narrow.count == full.count == 19
+    rows = 150 if prefill else 37
+    x = (torch.randn((rows, 512), device=DEV) * 0.5).to(torch.bfloat16)
+    picks = picks_for(rows, 18)
+    a_n, y_n = run(narrow, x, picks, prefill=prefill, y_dtype=y_dtype)
+    a_f, y_f = run(full, x, picks, prefill=prefill, y_dtype=y_dtype)
+    assert torch.equal(a_n, a_f) and torch.equal(y_n, y_f)
+
+
+@pytest.mark.parametrize("bits_up,bits_down", [(2, 3), (3, 3)])
+def test_narrow_pairs_do_not_depend_on_the_window(bits_up, bits_down):
+    narrow, _ = pair(bits_up, bits_down)
+    rows = 24
+    x = (torch.randn((rows, 512), device=DEV) * 0.5).to(torch.bfloat16)
+    picks = picks_for(rows, 18, seed=9)
+    act, y = run(narrow, x, picks)
+    alone = [run(narrow, x[r:r + 1], picks[r:r + 1]) for r in range(rows)]
+    assert torch.equal(act, torch.cat([a[0] for a in alone])) and torch.equal(y, torch.cat([a[1] for a in alone]))
+
+
+def test_narrow_is_smaller():
+    narrow, full = pair(2, 3)
+    # a block: 2 * bits words a lane (4-bit: 8), then 32 words of scales and biases
+    assert (narrow.up.shape[-1], narrow.down.shape[-1], full.up.shape[-1]) == (160, 224, 288)
