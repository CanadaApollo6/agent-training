+def test_a_qwen_boolean_in_pythons_spelling_is_the_boolean():
+    from tensorfold.cuda.reply_text import parse_tool_calls
+
+    tools = [{"type": "function", "function": {"name": "Edit", "parameters": {"type": "object", "properties": {
+        "replace_all": {"type": "boolean"}, "old_string": {"type": "string"}}}}}]
+    def args(flag, text="False"):
+        call = (f"<tool_call>\n<function=Edit>\n<parameter=replace_all>\n{flag}\n</parameter>\n"
+                f"<parameter=old_string>\n{text}\n</parameter>\n</function>\n</tool_call>")
+        return json.loads(parse_tool_calls(call, tools)[1][0]["function"]["arguments"])
+    assert [args(f)["replace_all"] for f in ("False", "True", "false", "true")] == [False, True, False, True]
