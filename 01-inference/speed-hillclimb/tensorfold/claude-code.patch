+"""``/v1/messages``: the Anthropic Messages API over the CUDA server's chat path, the way Claude Code calls it."""
+
+import http.client
+import json
+import time
+
+import pytest
+
+from tensorfold.cuda import server
+from tensorfold.server import anthropic
+from tests.test_cuda_admission import http_server
+from tests.test_cuda_tool_choice import CLOSE, EOS, Engine, Tokens, app_for
+
+TOOLS = [{"name": "get_weather", "description": "Weather in a city",
+          "input_schema": {"type": "object", "properties": {"city": {"type": "string"}}}},
+         {"type": "web_search_20250305", "name": "web_search", "max_uses": 3}]
+
+
+def post(port, body, path="/v1/messages?beta=true"):
+    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=5)
+    try:
+        connection.request("POST", path, json.dumps(body), {"Content-Type": "application/json",
+                                                             "x-api-key": "none", "anthropic-version": "2023-06-01"})
+        response = connection.getresponse()
+        return response.status, response.read().decode()
+    finally:
+        connection.close()
+
+
+def ask(app, path="/v1/messages?beta=true", **body):
+    body = {"model": "ornith-test", "max_tokens": 64, "messages": [{"role": "user", "content": "Say hello."}], **body}
+    with http_server(app) as port:
+        return post(port, body, path)
+
+
+def events(text):
+    """(event, data) pairs of an SSE stream."""
+
+    out = []
+    for chunk in text.split("\n\n"):
+        lines = dict(line.split(": ", 1) for line in chunk.splitlines() if ": " in line)
+        if "event" in lines:
+            out.append((lines["event"], json.loads(lines["data"])))
+    return out
+
+
+def test_a_claude_code_conversation_becomes_the_chat_it_means():
+    body = {
+        "model": "x", "max_tokens": 32000, "stream": True, "temperature": 1, "stop_sequences": ["END"],
+        "system": [{"type": "text", "text": "You are Claude Code.", "cache_control": {"type": "ephemeral"}},
+                   {"type": "text", "text": "Be brief."}],
+        "messages": [
+            {"role": "user", "content": [{"type": "text", "text": "<system-reminder>x</system-reminder>"},
+                                         {"type": "text", "text": "Weather in Oslo?"}]},
+            {"role": "assistant", "content": [
+                {"type": "thinking", "thinking": "need the tool", "signature": "tensorfold"},
+                {"type": "text", "text": "Checking."},
+                {"type": "tool_use", "id": "call_1", "name": "get_weather", "input": {"city": "Oslo"}}]},
+            {"role": "user", "content": [
+                {"type": "tool_result", "tool_use_id": "call_1", "content": [{"type": "text", "text": "rain"},
+                                                                           {"type": "image", "source": {}}]},
+                {"type": "text", "text": "And tomorrow?"}]},
+            {"role": "assistant", "content": "Sun."},
+            {"role": "system", "content": [{"type": "text", "text": "Plan mode is off."}]},
+            {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "call_2", "is_error": True,
+                                          "content": "no such city"}]}],
+        "tools": TOOLS, "tool_choice": {"type": "any", "disable_parallel_tool_use": True},
+        "thinking": {"type": "disabled"}}
+    chat = anthropic.to_chat(body)
+    assert chat["messages"] == [
+        {"role": "system", "content": "You are Claude Code.\n\nBe brief."},
+        {"role": "user", "content": "<system-reminder>x</system-reminder>\n\nWeather in Oslo?"},
+        {"role": "assistant", "content": "Checking.", "reasoning_content": "need the tool",
+         "tool_calls": [{"id": "call_1", "type": "function",
+                         "function": {"name": "get_weather", "arguments": '{"city": "Oslo"}'}}]},
+        {"role": "tool", "tool_call_id": "call_1", "content": f"rain\n\n{anthropic.IMAGE_NOTE}"},
+        {"role": "user", "content": "And tomorrow?"},
+        {"role": "assistant", "content": "Sun."},
+        {"role": "system", "content": "Plan mode is off."},
+        {"role": "tool", "tool_call_id": "call_2", "content": "Error: no such city"}]
+    assert [t["function"]["name"] for t in chat["tools"]] == ["get_weather"]       # the server tool is dropped
+    assert chat["tools"][0]["function"]["parameters"] == TOOLS[0]["input_schema"]
+    assert chat["tool_choice"] == "required" and chat["parallel_tool_calls"] is False
+    assert chat["chat_template_kwargs"] == {"enable_thinking": False}
+    assert (chat["max_tokens"], chat["temperature"], chat["stop"], chat["stream"]) == (32000, 1, ["END"], True)
+    assert anthropic.to_chat({"messages": [], "tool_choice": {"type": "tool", "name": "f"},
+                              "tools": TOOLS[:1]})["tool_choice"] == {"type": "function", "function": {"name": "f"}}
+    assert "chat_template_kwargs" not in anthropic.to_chat({"messages": []})       # the server's default
+
+
+def test_a_whole_reply_is_a_message_with_thinking_then_text(tmp_path):
+    status, text = ask(app_for(tmp_path, Engine()), thinking={"type": "enabled", "budget_tokens": 1000})
+    reply = json.loads(text)
+    assert status == 200 and reply["type"] == "message" and reply["model"] == "ornith-test"
+    assert reply["id"].startswith("msg_") and reply["stop_reason"] == "end_turn"
+    assert reply["content"] == [{"type": "thinking", "thinking": "the user wants hi", "signature": "tensorfold"},
+                                {"type": "text", "text": "Hi!"}]
+    assert reply["usage"]["input_tokens"] > 0 and reply["usage"]["output_tokens"] > 0
+
