+@pytest.mark.parametrize("stream", [False, True])
+def test_a_call_comes_back_as_tool_use(tmp_path, stream):
+    status, text = ask(app_for(tmp_path, Engine()), stream=stream, tools=TOOLS, tool_choice={"type": "any"},
+                       max_tokens=256)
+    assert status == 200
+    if stream:
+        seen = events(text)
+        blocks = [d["content_block"] for e, d in seen if e == "content_block_start"]
+        assert [b["type"] for b in blocks] == ["tool_use"] and blocks[0]["name"] == "get_weather"
+        parts = [d["delta"]["partial_json"] for e, d in seen
+                 if e == "content_block_delta" and d["delta"]["type"] == "input_json_delta"]
+        assert json.loads("".join(parts)) == {"city": "Oslo"}
+        assert [d for e, d in seen if e == "message_delta"][0]["delta"]["stop_reason"] == "tool_use"
+        assert "<tool_call>" not in text
+    else:
+        reply = json.loads(text)
+        assert reply["stop_reason"] == "tool_use"
+        assert [(b["type"], b["name"], b["input"]) for b in reply["content"]] == [
+            ("tool_use", "get_weather", {"city": "Oslo"})]
