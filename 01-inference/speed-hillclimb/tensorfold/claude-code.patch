+def test_a_waiting_stream_gets_pings(tmp_path, monkeypatch):
+    class Slow(Engine):
+        def generate(self, prompt, max_tokens, sampling, on_tokens, draft=True):
+            time.sleep(0.3)
+            return super().generate(prompt, max_tokens, sampling, on_tokens, draft)
+
+    monkeypatch.setattr(server, "ANTHROPIC_PING_S", 0.05)
+    status, text = ask(app_for(tmp_path, Slow()), stream=True)
+    names = [e for e, _ in events(text)]
+    assert status == 200 and names[0] == "message_start" and "ping" in names and names[-1] == "message_stop"
+
