+def test_a_streamed_reply_opens_one_block_at_a_time(tmp_path):
+    status, text = ask(app_for(tmp_path, Engine()), stream=True, thinking={"type": "enabled"})
+    seen = events(text)
+    assert status == 200 and seen[0][0] == "message_start" and seen[-1][0] == "message_stop"
+    starts = [(d["index"], d["content_block"]["type"]) for e, d in seen if e == "content_block_start"]
+    stops = [d["index"] for e, d in seen if e == "content_block_stop"]
+    assert starts == [(0, "thinking"), (1, "text")] and stops == [0, 1]
+    deltas = [d["delta"] for e, d in seen if e == "content_block_delta"]
+    assert "".join(d.get("thinking", "") for d in deltas) == "the user wants hi"
+    assert "".join(d.get("text", "") for d in deltas) == "Hi!"
+    assert {"type": "signature_delta", "signature": "tensorfold"} in deltas
+    last = [d for e, d in seen if e == "message_delta"][0]
+    assert last["delta"]["stop_reason"] == "end_turn" and last["usage"]["output_tokens"] > 0
+    # every delta lands inside its open block
+    open_block = None
+    for event, data in seen:
+        if event == "content_block_start":
+            assert open_block is None
+            open_block = data["index"]
+        elif event == "content_block_delta":
+            assert data["index"] == open_block
+        elif event == "content_block_stop":
+            open_block = None
+
