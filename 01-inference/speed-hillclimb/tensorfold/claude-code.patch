+"""The Anthropic Messages API (``/v1/messages``) over the chat path, so Claude Code can drive a served model.
+
+A Messages request becomes a chat-completions body: the system blocks a system message, ``tool_use`` blocks tool calls,
+``tool_result`` blocks tool messages, and ``thinking`` blocks the assistant's ``reasoning_content``, so the chat template
+replays the model's earlier reasoning exactly as it would for an OpenAI client. The reply comes back as a Message, or
+as Messages stream events: a thinking block, then a text block, then one ``tool_use`` block per call.
+
+The server serves one model and has no vision here, so ``model`` is echoed and an image becomes a short note.
+"""
+from __future__ import annotations
+
+import json
+import re
+from typing import Any
+
+IMAGE_NOTE = "[image omitted: this server reads text only]"
+SIGNATURE = "tensorfold"           # thinking blocks need a signature; only this server reads it back
+STOP_REASONS = {"tool_calls": "tool_use", "stop": "end_turn", "length": "max_tokens"}
+
+
+def _text(content: Any) -> str:
+    """A tool result's or a system prompt's content as plain text."""
+
+    if content is None:
+        return ""
+    if isinstance(content, str):
+        return content
+    parts = []
+    for block in content:
+        kind = block.get("type")
+        if kind == "text":
+            parts.append(block.get("text", ""))
+        elif kind == "image":
+            parts.append(IMAGE_NOTE)
+        else:                                      # documents, search results: their JSON, rather than nothing
+            parts.append(json.dumps(block, ensure_ascii=False))
+    return "\n\n".join(p for p in parts if p)
+
+
+def _messages(body: dict[str, Any]) -> list[dict[str, Any]]:
+    out: list[dict[str, Any]] = []
+    system = _text(body.get("system"))
+    if system:
+        out.append({"role": "system", "content": system})
+    for message in body.get("messages") or []:
+        role, content = message.get("role"), message.get("content")
+        if role == "system":                       # Claude Code sends some mid-conversation; the chat path places them
+            out.append({"role": "system", "content": _text(content)})
+            continue
+        if role not in ("user", "assistant"):
+            raise ValueError(f"messages: role must be user, assistant or system, not {role!r}")
+        if isinstance(content, str):
+            out.append({"role": role, "content": content})
+            continue
+        if role == "assistant":
+            text, reasoning, calls = [], [], []
+            for block in content or []:
+                kind = block.get("type")
+                if kind == "text":
+                    text.append(block.get("text", ""))
+                elif kind == "thinking":
+                    reasoning.append(block.get("thinking", ""))
+                elif kind in ("tool_use", "server_tool_use"):
+                    calls.append({"id": block["id"], "type": "function",
+                                  "function": {"name": block["name"],
+                                               "arguments": json.dumps(block.get("input") or {}, ensure_ascii=False)}})
+            turn: dict[str, Any] = {"role": "assistant", "content": "".join(text)}
+            if reasoning:
+                turn["reasoning_content"] = "".join(reasoning)
+            if calls:
+                turn["tool_calls"] = calls
+            out.append(turn)
+            continue
+        text = []
+        for block in content or []:                # tool results lead a user turn, as the API requires
+            kind = block.get("type")
+            if kind == "tool_result":
+                result = _text(block.get("content"))
+                if block.get("is_error") and not result.lstrip().startswith(("Error", "<tool_use_error>")):
+                    result = f"Error: {result}"
+                out.append({"role": "tool", "tool_call_id": block.get("tool_use_id"), "content": result})
+            elif kind == "text":
+                text.append(block.get("text", ""))
+            elif kind == "image":
+                text.append(IMAGE_NOTE)
+            elif kind == "document":
+                text.append(_text([block]))
+        if text:
+            out.append({"role": "user", "content": "\n\n".join(text)})
+    return out
+
+
+def _tool_choice(choice: dict[str, Any] | None) -> Any:
+    kind = (choice or {}).get("type", "auto")
+    if kind == "any":
+        return "required"
+    if kind == "tool":
+        return {"type": "function", "function": {"name": choice["name"]}}
+    return "none" if kind == "none" else "auto"
+
+
+def to_chat(body: dict[str, Any]) -> dict[str, Any]:
+    """The chat-completions body for a Messages request; ValueError, KeyError or TypeError if it's malformed."""
+
+    if not isinstance(body, dict):
+        raise ValueError("the request body must be a JSON object")
+    chat: dict[str, Any] = {"messages": _messages(body), "stream": bool(body.get("stream"))}
+    tools = [{"type": "function", "function": {"name": t["name"], "description": t.get("description", ""),
+                                               "parameters": t.get("input_schema") or {"type": "object",
+                                                                                       "properties": {}}}}
+             for t in body.get("tools") or [] if "input_schema" in t]   # server tools (web search...) have none
+    if tools:
+        chat["tools"] = tools
+        chat["tool_choice"] = _tool_choice(body.get("tool_choice"))
+        if (body.get("tool_choice") or {}).get("disable_parallel_tool_use"):
+            chat["parallel_tool_calls"] = False
+    thinking = (body.get("thinking") or {}).get("type")
+    if thinking == "disabled":
+        chat["chat_template_kwargs"] = {"enable_thinking": False}
+    elif thinking in ("enabled", "adaptive"):
+        chat["chat_template_kwargs"] = {"enable_thinking": True}
+    for name in ("max_tokens", "temperature", "top_p", "top_k"):
+        if body.get(name) is not None:
+            chat[name] = body[name]
+    if body.get("stop_sequences"):
+        chat["stop"] = list(body["stop_sequences"])
+    return chat
+
+
+def _input(arguments: Any) -> dict[str, Any]:
+    if isinstance(arguments, str):
+        try:
+            arguments = json.loads(arguments or "{}")
+        except json.JSONDecodeError:
+            return {"_raw": arguments}
+    return arguments if isinstance(arguments, dict) else {"_value": arguments}
+
+
+def message(result: dict[str, Any], model: str, rid: str) -> dict[str, Any]:
+    """A whole reply (``App.run``'s result) as a Message."""
+
+    content: list[dict[str, Any]] = []
+    if result["reasoning"]:
+        content.append({"type": "thinking", "thinking": result["reasoning"], "signature": SIGNATURE})
+    if result["content"]:
+        content.append({"type": "text", "text": result["content"]})
+    for call in result["calls"] or []:
+        content.append({"type": "tool_use", "id": call["id"], "name": call["function"]["name"],
+                        "input": _input(call["function"]["arguments"])})
+    return {"id": rid, "type": "message", "role": "assistant", "model": model, "content": content,
+            "stop_reason": STOP_REASONS.get(result["finish"], "end_turn"), "stop_sequence": None,
+            "usage": {"input_tokens": result["prompt_tokens"], "output_tokens": result["completion_tokens"]}}
+
+
+def sse(event: str, data: dict[str, Any]) -> str:
+    return f"event: {event}\ndata: {json.dumps(data, ensure_ascii=False)}\n\n"
+
+
+class EventStream:
+    """A streamed reply as Messages events: ``start``, then ``delta`` per chat delta, then ``finish``."""
+
+    def __init__(self, model: str, rid: str, input_tokens: int):
+        self.model, self.rid, self.input_tokens = model, rid, input_tokens
+        self.index, self.open = -1, None
+
+    def start(self) -> str:
+        return sse("message_start", {"type": "message_start", "message": {
+            "id": self.rid, "type": "message", "role": "assistant", "model": self.model, "content": [],
+            "stop_reason": None, "stop_sequence": None,
+            "usage": {"input_tokens": self.input_tokens, "output_tokens": 0}}})
+
+    def _close(self) -> str:
+        if self.open is None:
+            return ""
+        out = ""
+        if self.open == "thinking":
+            out += sse("content_block_delta", {"type": "content_block_delta", "index": self.index,
+                                               "delta": {"type": "signature_delta", "signature": SIGNATURE}})
+        self.open = None
+        return out + sse("content_block_stop", {"type": "content_block_stop", "index": self.index})
+
+    def _block(self, kind: str) -> str:
+        if self.open == kind:
+            return ""
+        out = self._close()
+        self.index += 1
+        self.open = kind
+        block = {"type": "thinking", "thinking": "", "signature": ""} if kind == "thinking" else {"type": "text",
+                                                                                                    "text": ""}
+        return out + sse("content_block_start", {"type": "content_block_start", "index": self.index,
+                                                 "content_block": block})
+
+    def delta(self, delta: dict[str, Any]) -> str:
+        out = ""
+        if delta.get("reasoning_content"):
+            out += self._block("thinking") + sse("content_block_delta", {
+                "type": "content_block_delta", "index": self.index,
+                "delta": {"type": "thinking_delta", "thinking": delta["reasoning_content"]}})
+        if delta.get("content"):
+            out += self._block("text") + sse("content_block_delta", {
+                "type": "content_block_delta", "index": self.index,
+                "delta": {"type": "text_delta", "text": delta["content"]}})
+        return out
+
+    def finish(self, result: dict[str, Any]) -> str:
+        out = self.delta(result["final"]) + self._close()
+        for call in result["calls"] or []:
+            self.index += 1
+            arguments = call["function"]["arguments"]
+            out += sse("content_block_start", {"type": "content_block_start", "index": self.index, "content_block": {
+                "type": "tool_use", "id": call["id"], "name": call["function"]["name"], "input": {}}})
+            out += sse("content_block_delta", {"type": "content_block_delta", "index": self.index, "delta": {
+                "type": "input_json_delta",
+                "partial_json": json.dumps(_input(arguments), ensure_ascii=False)}})
+            out += sse("content_block_stop", {"type": "content_block_stop", "index": self.index})
+        out += sse("message_delta", {"type": "message_delta",
+                                     "delta": {"stop_reason": STOP_REASONS.get(result["finish"], "end_turn"),
+                                               "stop_sequence": None},
+                                     "usage": {"output_tokens": result["completion_tokens"]}})
+        return out + sse("message_stop", {"type": "message_stop"})
+
+
+def error(kind: str, text: str) -> dict[str, Any]:
+    return {"type": "error", "error": {"type": kind, "message": text}}
+
+
+def too_long(text: str, limit: int | None) -> str | None:
+    """The API's own wording for a prompt over the window, which Claude Code reads as a cue to compact."""
+
+    found = re.match(r"the rendered prompt has (\d+) tokens", text)
+    if found and limit:
+        return f"prompt is too long: {found.group(1)} tokens > {limit} maximum"
+    return None
